{
  "_comment": "make:modules-from-db blueprint for super-suite. See README.md for what each module pins down and why. Every module_types entry below is a mechanism a real defect escaped through.",
  "connection": null,
  "id_type": "bigint",

  "groups": {
    "Suite": [
      "suite_order_types",
      "suite_ledgers",
      "suite_receipts",
      "suite_orders",
      "suite_order_lines",
      "suite_contracts",
      "suite_profiles",
      "suite_edge_cases",
      "suite_warehouses",
      "suite_movements",
      "suite_suppliers",
      "suite_customers",
      "suite_settlements",
      "suite_sites",
      "suite_notices",
      "suite_site_visits",
      "suite_pings",
      "suite_tickets"
    ]
  },

  "module_types": {
    "SuiteOrderTypes": ["simple_crud"],
    "SuiteLedgers": ["simple_crud"],
    "SuiteReceipts": ["simple_crud"],
    "SuiteOrders": ["inline_items_parent", "has_actions"],
    "SuiteOrderLines": ["inline_items_child"],
    "SuiteContracts": ["status_machine", "has_actions"],
    "SuiteProfiles": ["simple_crud"],
    "SuiteEdgeCases": ["simple_crud"],
    "SuiteWarehouses": ["has_delegations"],
    "SuiteMovements": ["simple_crud"],
    "SuiteSuppliers": ["morph_target"],
    "SuiteCustomers": ["morph_target"],
    "SuiteSettlements": ["simple_crud"],
    "SuiteSites": ["location_bearing", "has_actions", "has_delegations"],
    "SuiteNotices": ["location_bearing_nullable"],
    "SuiteSiteVisits": ["delegation_child_of_location_bearing_parent"],
    "SuitePings": ["location_bearing_opt_out"],
    "SuiteTickets": ["bulk_actions", "export_import", "create_wizard", "wizard_action", "splash_and_service_method", "two_url_params"]
  },

  "morphs": [
    {
      "table": "suite_settlements",
      "name": "payable",
      "targets": [
        {
          "alias": "suite_supplier",
          "model": "App\\Project\\Modules\\System\\Suite\\SuiteSuppliers\\SuiteSuppliersModel",
          "module": "Suite/SuiteSuppliers",
          "label": "Supplier"
        },
        {
          "alias": "suite_customer",
          "model": "App\\Project\\Modules\\System\\Suite\\SuiteCustomers\\SuiteCustomersModel",
          "module": "Suite/SuiteCustomers",
          "label": "Customer"
        }
      ]
    }
  ],

  "delegations": {
    "SuiteSites": [
      {
        "_comment": "A delegation whose PARENT is location-bearing: the parent fetch must apply the record scope, or a foreign site's uuid in the URL lists its visits.",
        "name": "SiteVisits",
        "related": "Suite/SuiteSiteVisits",
        "ui": "tab",
        "filter_key": "site_id",
        "operations": {
          "list": { "enabled": true },
          "view": { "enabled": true },
          "create": { "enabled": true }
        }
      }
    ],
    "SuiteWarehouses": [
      {
        "name": "Movements",
        "related": "Suite/SuiteMovements",
        "ui": "tab",
        "filter_key": "warehouse_id",
        "operations": {
          "list": { "enabled": true },
          "view": { "enabled": true },
          "create": { "enabled": true },
          "edit": { "enabled": true },
          "delete": { "enabled": true }
        }
      }
    ],
    "SuiteSuppliers": [
      {
        "_comment": "A morph-FILTERED delegation: only settlements whose payable_type is this target. Distinct from an ordinary FK delegation, and the reason two morph targets exist rather than one.",
        "name": "Settlements",
        "related": "Suite/SuiteSettlements",
        "ui": "tab",
        "filter_key": "payable_id",
        "morph_type_column": "payable_type",
        "morph_type_value": "suite_supplier",
        "operations": {
          "list": { "enabled": true },
          "view": { "enabled": true }
        }
      }
    ]
  },

  "inline_items": {
    "SuiteOrders": [
      {
        "key": "order_lines",
        "label": "Order Lines",
        "child_module": "SuiteOrderLines",
        "child_group": "Suite",
        "parent_fk": "order_id",
        "primary_field": "description",
        "variant": "table",
        "modal_size": "lg",
        "modal_columns": 2,
        "totals": [{ "field": "line_total", "label": "Total", "sync_to": "total" }],
        "fields": [
          { "key": "description", "label": "Description", "type": "input", "required": true, "col_span": 2 },
          {
            "_comment": "A select with LITERAL options and no related model. Until v3.4.25 this was read as an FK: _id stripped, camelCased, handed to ::with() -> View endpoint 500s on an undefined relationship.",
            "key": "line_kind",
            "label": "Kind",
            "type": "select",
            "required": true,
            "col_span": 1,
            "options": [
              { "id": "GOODS", "name": "Goods" },
              { "id": "SERVICE", "name": "Service" },
              { "id": "DISCOUNT", "name": "Discount" }
            ]
          },
          {
            "_comment": "A splash_key-resolved select: also not a relation, and a different branch from the literal-options case above.",
            "key": "status_key",
            "label": "Status",
            "type": "select",
            "required": true,
            "col_span": 1,
            "splash_key": "line_statuses"
          },
          {
            "_comment": "A REAL FK. The fix must skip the two above and still eager-load this one -- a generator that skipped every select would pass a fixture containing only the broken shape.",
            "key": "order_type_id",
            "label": "Order Type",
            "type": "api-select",
            "col_span": 1
          },
          { "key": "quantity", "label": "Qty", "type": "number", "col_span": 1 },
          { "key": "line_total", "label": "Line Total", "type": "number", "col_span": 1 }
        ]
      }
    ]
  },

  "actions": {
    "SuiteContracts": [
      {
        "name": "activate",
        "label": "Activate",
        "description": "Activate this contract",
        "icon": "PlayIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "main",
        "destructive": false,
        "operations": { "create": { "enabled": true }, "view": { "enabled": true }, "list": { "enabled": true } }
      },
      {
        "name": "terminate",
        "label": "Terminate",
        "description": "Terminate this contract early",
        "icon": "XCircleIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "more",
        "destructive": true,
        "urlParams": ["uuid"],
        "operations": { "create": { "enabled": true }, "view": { "enabled": true } }
      }
    ],
    "SuiteTickets": [
      {
        "_comment": "A WIZARD action: two steps plus the Review & Confirm step, on a row. Its effect (priority, assignee, reason) is filled in by module-overlays/, because the generated service is a write-once stub. Only a create (POST) operation: a `view` op is a GET route that runs the SAME service method, so an action that writes must not declare one.",
        "name": "escalate",
        "label": "Escalate",
        "description": "Raise a ticket's priority and hand it to someone",
        "icon": "ArrowUpIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "more",
        "destructive": false,
        "urlParams": ["uuid"],
        "fields": [
          { "field": "priority", "label": "Priority", "field_type": "select", "type": "text", "required": true,
            "options": [ { "id": "low", "name": "Low" }, { "id": "normal", "name": "Normal" }, { "id": "high", "name": "High" } ] },
          { "field": "assignee_id", "label": "Assign to", "field_type": "api-select", "type": "text", "required": true,
            "api_url": "/select/users", "option_label": "name", "option_value": "id" },
          { "field": "reason", "label": "Reason", "field_type": "textarea", "type": "text", "required": true }
        ],
        "wizard": {
          "enabled": true,
          "steps": [
            { "title": "Priority", "field_keys": ["priority"] },
            { "title": "Assignment", "field_keys": ["assignee_id", "reason"] }
          ]
        },
        "confirm_step": { "enabled": true },
        "operations": { "create": { "enabled": true } }
      },
      {
        "_comment": "splash:true adds GET .../splash to pre-load option lists before the form opens; serviceMethod/serviceArgs bind the endpoint to a hand-written method on the action's service instead of the default execute().",
        "name": "assign",
        "label": "Assign",
        "description": "Assign a ticket to a user",
        "icon": "UserPlusIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "more",
        "destructive": false,
        "urlParams": ["uuid"],
        "splash": true,
        "serviceMethod": "assignTo",
        "serviceArgs": ["data", "param:uuid", "user"],
        "fields": [
          { "field": "assignee_id", "label": "Assign to", "field_type": "api-select", "type": "text", "required": true,
            "api_url": "/select/users", "option_label": "name", "option_value": "id" }
        ],
        "operations": { "create": { "enabled": true } }
      },
      {
        "_comment": "TWO url params. The engine generates no PHPUnit contract test for anything but [] or ['uuid'] (documented), so the route is asserted by backend-tests/TicketActionsTest.php. hasUI:false: an API-only action.",
        "name": "archiveByYear",
        "label": "Archive by year",
        "description": "Archive a ticket for a given year",
        "hasUI": false,
        "placement": "more",
        "destructive": true,
        "urlParams": ["uuid", "year"],
        "operations": { "create": { "enabled": true } }
      }
    ],
    "SuiteSites": [
      {
        "_comment": "A record-level action on a location-bearing module: the action's record fetch must apply the same scope as view/edit/delete.",
        "name": "checkIn",
        "label": "Check in",
        "description": "Record a check-in at this site",
        "icon": "MapPinIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "more",
        "destructive": false,
        "urlParams": ["uuid"],
        "operations": { "create": { "enabled": true }, "view": { "enabled": true } }
      }
    ],
    "SuiteOrders": [
      {
        "name": "approve",
        "label": "Approve",
        "description": "Approve this order",
        "icon": "CheckIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "main",
        "destructive": false,
        "operations": { "create": { "enabled": true }, "view": { "enabled": true }, "list": { "enabled": true } }
      }
    ]
  },

  "seeders": {
    "SuiteOrderTypes": [
      { "name": "Standard", "code": "STD", "is_active": 1 },
      { "name": "Express", "code": "EXP", "is_active": 1 },
      { "name": "Backorder", "code": "BACK", "is_active": 0 },
      { "name": "Priority", "code": "PRI", "is_active": 1 },
      { "name": "Wholesale", "code": "WHL", "is_active": 1 },
      { "name": "Retail", "code": "RTL", "is_active": 1 },
      { "name": "Return", "code": "RET", "is_active": 1 },
      { "name": "Sample", "code": "SMP", "is_active": 1 },
      { "name": "Transfer", "code": "TRF", "is_active": 1 },
      { "name": "Service", "code": "SVC", "is_active": 1 },
      { "name": "Consignment", "code": "CON", "is_active": 1 }
    ],
    "SuiteTickets": [
      { "title": "Printer offline", "status_id": 1, "priority": "normal" },
      { "title": "VPN drops hourly", "status_id": 1, "priority": "high" },
      { "title": "New starter laptop", "status_id": 1, "priority": "low" },
      { "title": "Shared drive full", "status_id": 1, "priority": "normal" },
      { "title": "Badge reader jammed", "status_id": 1, "priority": "high" },
      { "title": "Old monitor disposal", "status_id": 1, "priority": "low" }
    ]
  },

  "module_overrides": {
    "_comment": "Per-module config the blueprint has no dedicated key for, deep-merged over the assembled config just before generation (objects merge, lists replace).",
    "SuitePings": {
      "_comment": "Has a location_id and must NOT be scoped: the explicit opt-out beats the column.",
      "location_bearing": false
    },
    "SuiteTickets": {
      "_comment": "Bulk actions (generic + status_target), export/import, and a multi-step Create form: none has a blueprint key. status_target writes status_id = Model::DONE, so DONE must be a constant. A wizard partitions the form: a REQUIRED field named by no step is never rendered and the create 422s, so status_id is in step 1. A bulk action's variant is one of default | primary | danger.",
      "constants": { "OPEN": 1, "DONE": 2 },
      "features": {
        "backend": {
          "list": {
            "export": true,
            "import": true,
            "bulk_actions": [
              { "key": "archive", "label": "Archive", "icon": "Archive", "variant": "default", "confirmMessage": "Archive the selected tickets?" },
              { "key": "close", "label": "Close", "icon": "CheckCircle", "variant": "primary", "status_target": "DONE", "confirmMessage": "Close the selected tickets?" },
              { "key": "expedite", "label": "Expedite", "icon": "Zap", "variant": "danger", "confirmMessage": "Expedite the selected tickets? Blocked ones will fail." }
            ]
          }
        },
        "frontend": {
          "create": {
            "wizard": {
              "enabled": true,
              "steps": [
                { "title": "Basics", "field_keys": ["title", "status_id", "priority"] },
                { "title": "Assignment", "field_keys": ["assignee_id", "reason"] }
              ]
            }
          }
        }
      }
    }
  },

  "menu_config": {
    "sections": {
      "suite": { "label": "Super Suite", "icon": "FlaskConical", "order": 1 }
    }
  }
}
