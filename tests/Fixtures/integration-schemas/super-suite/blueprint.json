{
  "_comment": "make:modules-from-db blueprint for super-suite. See README.md for what each module pins down and why. Every module_types entry below is a mechanism a real defect escaped through.",
  "connection": null,
  "id_type": "bigint",

  "groups": {
    "Suite": [
      "suite_order_types",
      "suite_ledgers",
      "suite_receipts",
      "suite_orders",
      "suite_order_lines",
      "suite_contracts",
      "suite_profiles",
      "suite_edge_cases",
      "suite_warehouses",
      "suite_movements",
      "suite_suppliers",
      "suite_customers",
      "suite_settlements",
      "suite_sites",
      "suite_notices",
      "suite_site_visits",
      "suite_pings",
      "suite_tickets",
      "suite_policies",
      "suite_documents",
      "suite_kits",
      "suite_invoices",
      "suite_invoice_lines",
      "suite_invoice_notes",
      "suite_proforma_invoices",
      "suite_proforma_invoice_items"
    ]
  },

  "module_types": {
    "SuiteOrderTypes": ["simple_crud"],
    "SuiteLedgers": ["simple_crud"],
    "SuiteReceipts": ["simple_crud"],
    "SuiteOrders": ["inline_items_parent", "has_actions"],
    "SuiteOrderLines": ["inline_items_child"],
    "SuiteContracts": ["status_machine", "has_actions"],
    "SuiteProfiles": ["simple_crud"],
    "SuiteEdgeCases": ["simple_crud"],
    "SuiteWarehouses": ["has_delegations"],
    "SuiteMovements": ["simple_crud"],
    "SuiteSuppliers": ["morph_target"],
    "SuiteCustomers": ["morph_target"],
    "SuiteSettlements": ["simple_crud"],
    "SuiteSites": ["location_bearing", "has_actions", "has_delegations"],
    "SuiteNotices": ["location_bearing_nullable"],
    "SuiteSiteVisits": ["delegation_child_of_location_bearing_parent"],
    "SuitePings": ["location_bearing_opt_out"],
    "SuiteTickets": ["bulk_actions", "export_import", "create_wizard", "wizard_action", "splash_and_service_method", "two_url_params"],
    "SuitePolicies": ["json_rules", "string_constants", "drafts_off"],
    "SuiteDocuments": ["file_column", "processors"],
    "SuiteKits": ["item_picker", "json_rules", "custom_splash"],
    "SuiteInvoices": ["inline_items_parent", "two_inline_entries", "inject_from_parent"],
    "SuiteInvoiceLines": ["inline_items_child"],
    "SuiteInvoiceNotes": ["inline_items_child"],
    "SuiteProformaInvoices": ["create_wizard_with_inline_step", "inline_items_parent"],
    "SuiteProformaInvoiceItems": ["inline_items_child"]
  },

  "morphs": [
    {
      "table": "suite_settlements",
      "name": "payable",
      "targets": [
        {
          "alias": "suite_supplier",
          "model": "App\\Project\\Modules\\System\\Suite\\SuiteSuppliers\\SuiteSuppliersModel",
          "module": "Suite/SuiteSuppliers",
          "label": "Supplier",
          "delegate": { "enabled": true, "relation_name": "settlements", "tab_label": "Settlements" }
        },
        {
          "alias": "suite_customer",
          "model": "App\\Project\\Modules\\System\\Suite\\SuiteCustomers\\SuiteCustomersModel",
          "module": "Suite/SuiteCustomers",
          "label": "Customer",
          "delegate": { "enabled": true, "relation_name": "settlements", "tab_label": "Settlements" }
        }
      ]
    }
  ],

  "delegations": {
    "SuiteSites": [
      {
        "_comment": "A delegation whose PARENT is location-bearing: the parent fetch must apply the record scope, or a foreign site's uuid in the URL lists its visits.",
        "name": "SiteVisits",
        "related": "Suite/SuiteSiteVisits",
        "ui": "tab",
        "filter_key": "site_id",
        "operations": {
          "list": { "enabled": true },
          "view": { "enabled": true },
          "create": { "enabled": true }
        }
      }
    ],
    "SuiteWarehouses": [
      {
        "name": "Movements",
        "related": "Suite/SuiteMovements",
        "ui": "tab",
        "filter_key": "warehouse_id",
        "operations": {
          "list": { "enabled": true },
          "view": { "enabled": true },
          "create": { "enabled": true },
          "edit": { "enabled": true },
          "delete": { "enabled": true }
        }
      }
    ]
  },

  "inline_items": {
    "SuiteOrders": [
      {
        "key": "order_lines",
        "label": "Order Lines",
        "child_module": "SuiteOrderLines",
        "child_group": "Suite",
        "parent_fk": "order_id",
        "primary_field": "description",
        "variant": "table",
        "modal_size": "lg",
        "modal_columns": 2,
        "totals": [{ "field": "line_total", "label": "Total", "sync_to": "total" }],
        "fields": [
          { "key": "description", "label": "Description", "type": "input", "required": true, "col_span": 2 },
          {
            "_comment": "A select with LITERAL options and no related model. Until v3.4.25 this was read as an FK: _id stripped, camelCased, handed to ::with() -> View endpoint 500s on an undefined relationship.",
            "key": "line_kind",
            "label": "Kind",
            "type": "select",
            "required": true,
            "col_span": 1,
            "options": [
              { "id": "GOODS", "name": "Goods" },
              { "id": "SERVICE", "name": "Service" },
              { "id": "DISCOUNT", "name": "Discount" }
            ]
          },
          {
            "_comment": "A splash_key-resolved select: also not a relation, and a different branch from the literal-options case above.",
            "key": "status_key",
            "label": "Status",
            "type": "select",
            "required": true,
            "col_span": 1,
            "splash_key": "line_statuses"
          },
          {
            "_comment": "A REAL FK. The fix must skip the two above and still eager-load this one -- a generator that skipped every select would pass a fixture containing only the broken shape.",
            "key": "order_type_id",
            "label": "Order Type",
            "type": "api-select",
            "col_span": 1
          },
          { "key": "quantity", "label": "Qty", "type": "number", "col_span": 1 },
          { "key": "line_total", "label": "Line Total", "type": "number", "col_span": 1 }
        ]
      }
    ],
    "SuiteInvoices": [
      {
        "_comment": "The default CARD variant, no delete, and `currency` copied from the parent onto each child row. `currency` is deliberately NOT one of the inline fields: it is injected, so a client cannot pick it.",
        "key": "invoice_lines",
        "label": "Invoice Lines",
        "child_module": "SuiteInvoiceLines",
        "child_group": "Suite",
        "parent_fk": "invoice_id",
        "primary_field": "description",
        "can_delete": false,
        "inject_from_parent": [{ "child_field": "currency", "parent_field": "currency" }],
        "fields": [
          { "key": "description", "label": "Description", "type": "input", "required": true },
          { "key": "amount", "label": "Amount", "type": "number" }
        ]
      },
      {
        "_comment": "A second inline entry on the same parent: two extract/sync blocks in one Create/Edit service.",
        "key": "invoice_notes",
        "label": "Notes",
        "child_module": "SuiteInvoiceNotes",
        "child_group": "Suite",
        "parent_fk": "invoice_id",
        "primary_field": "body",
        "variant": "table",
        "fields": [
          { "key": "body", "label": "Note", "type": "input", "required": true }
        ]
      }
    ],
    "SuiteProformaInvoices": [
      {
        "_comment": "The items are a STEP of the create wizard (see module_overrides.SuiteProformaInvoices). The table variant with a `totals` footer whose `sync_to` keeps the parent's `total` equal to the sum of the rows.",
        "key": "proforma_items",
        "label": "Items",
        "child_module": "SuiteProformaInvoiceItems",
        "child_group": "Suite",
        "parent_fk": "proforma_id",
        "primary_field": "description",
        "variant": "table",
        "totals": [{ "field": "line_total", "label": "Total", "sync_to": "total" }],
        "fields": [
          { "key": "description", "label": "Description", "type": "input", "required": true },
          { "key": "quantity", "label": "Qty", "type": "number", "required": true },
          { "key": "unit_price", "label": "Unit Price", "type": "number", "required": true, "decimals": 2 },
          { "key": "line_total", "label": "Line Total", "type": "number", "decimals": 2 }
        ]
      }
    ]
  },

  "actions": {
    "SuiteContracts": [
      {
        "name": "activate",
        "label": "Activate",
        "description": "Activate this contract",
        "icon": "PlayIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "main",
        "destructive": false,
        "operations": { "create": { "enabled": true }, "view": { "enabled": true }, "list": { "enabled": true } }
      },
      {
        "name": "terminate",
        "label": "Terminate",
        "description": "Terminate this contract early",
        "icon": "XCircleIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "more",
        "destructive": true,
        "urlParams": ["uuid"],
        "operations": { "create": { "enabled": true }, "view": { "enabled": true } }
      }
    ],
    "SuiteTickets": [
      {
        "_comment": "A WIZARD action: two steps plus the Review & Confirm step, on a row. Its effect (priority, assignee, reason) is filled in by module-overlays/, because the generated service is a write-once stub. Only a create (POST) operation: a `view` op is a GET route that runs the SAME service method, so an action that writes must not declare one.",
        "name": "escalate",
        "label": "Escalate",
        "description": "Raise a ticket's priority and hand it to someone",
        "icon": "ArrowUpIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "more",
        "destructive": false,
        "urlParams": ["uuid"],
        "fields": [
          { "field": "priority", "label": "Priority", "field_type": "select", "type": "text", "required": true,
            "options": [ { "id": "low", "name": "Low" }, { "id": "normal", "name": "Normal" }, { "id": "high", "name": "High" } ] },
          { "field": "assignee_id", "label": "Assign to", "field_type": "api-select", "type": "text", "required": true,
            "api_url": "/select/users", "option_label": "name", "option_value": "id" },
          { "field": "reason", "label": "Reason", "field_type": "textarea", "type": "text", "required": true }
        ],
        "wizard": {
          "enabled": true,
          "steps": [
            { "title": "Priority", "field_keys": ["priority"] },
            { "title": "Assignment", "field_keys": ["assignee_id", "reason"] }
          ]
        },
        "confirm_step": { "enabled": true },
        "operations": { "create": { "enabled": true } }
      },
      {
        "_comment": "splash:true adds GET .../splash to pre-load option lists before the form opens; serviceMethod/serviceArgs bind the endpoint to a hand-written method on the action's service instead of the default execute().",
        "name": "assign",
        "label": "Assign",
        "description": "Assign a ticket to a user",
        "icon": "UserPlusIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "more",
        "destructive": false,
        "urlParams": ["uuid"],
        "splash": true,
        "serviceMethod": "assignTo",
        "serviceArgs": ["data", "param:uuid", "user"],
        "fields": [
          { "field": "assignee_id", "label": "Assign to", "field_type": "api-select", "type": "text", "required": true,
            "api_url": "/select/users", "option_label": "name", "option_value": "id" }
        ],
        "operations": { "create": { "enabled": true } }
      },
      {
        "_comment": "TWO url params. The engine generates no PHPUnit contract test for anything but [] or ['uuid'] (documented), so the route is asserted by backend-tests/TicketActionsTest.php. hasUI:false: an API-only action.",
        "name": "archiveByYear",
        "label": "Archive by year",
        "description": "Archive a ticket for a given year",
        "hasUI": false,
        "placement": "more",
        "destructive": true,
        "urlParams": ["uuid", "year"],
        "operations": { "create": { "enabled": true } }
      }
    ],
    "SuiteSites": [
      {
        "_comment": "A record-level action on a location-bearing module: the action's record fetch must apply the same scope as view/edit/delete.",
        "name": "checkIn",
        "label": "Check in",
        "description": "Record a check-in at this site",
        "icon": "MapPinIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "more",
        "destructive": false,
        "urlParams": ["uuid"],
        "operations": { "create": { "enabled": true }, "view": { "enabled": true } }
      }
    ],
    "SuiteOrders": [
      {
        "name": "approve",
        "label": "Approve",
        "description": "Approve this order",
        "icon": "CheckIcon",
        "hasUI": true,
        "uiType": "modal",
        "placement": "main",
        "destructive": false,
        "operations": { "create": { "enabled": true }, "view": { "enabled": true }, "list": { "enabled": true } }
      }
    ]
  },

  "seeders": {
    "SuiteOrderTypes": [
      { "name": "Standard", "code": "STD", "is_active": 1 },
      { "name": "Express", "code": "EXP", "is_active": 1 },
      { "name": "Backorder", "code": "BACK", "is_active": 0 },
      { "name": "Priority", "code": "PRI", "is_active": 1 },
      { "name": "Wholesale", "code": "WHL", "is_active": 1 },
      { "name": "Retail", "code": "RTL", "is_active": 1 },
      { "name": "Return", "code": "RET", "is_active": 1 },
      { "name": "Sample", "code": "SMP", "is_active": 1 },
      { "name": "Transfer", "code": "TRF", "is_active": 1 },
      { "name": "Service", "code": "SVC", "is_active": 1 },
      { "name": "Consignment", "code": "CON", "is_active": 1 }
    ],
    "SuiteTickets": [
      { "title": "Printer offline", "status_id": 1, "priority": "normal" },
      { "title": "VPN drops hourly", "status_id": 1, "priority": "high" },
      { "title": "New starter laptop", "status_id": 1, "priority": "low" },
      { "title": "Shared drive full", "status_id": 1, "priority": "normal" },
      { "title": "Badge reader jammed", "status_id": 1, "priority": "high" },
      { "title": "Old monitor disposal", "status_id": 1, "priority": "low" }
    ]
  },

  "module_overrides": {
    "_comment": "Per-module config the blueprint has no dedicated key for, deep-merged over the assembled config just before generation (objects merge, lists replace).",
    "SuiteEdgeCases": {
      "_comment": "One list column starts hidden. `$merge` patches a single entry of the generated fields list by its `key`, so the other columns (and their order) stay exactly as introspection produced them; a plain list here would replace all of them.",
      "features": {
        "frontend": {
          "list": {
            "fields": { "$merge": "key", "$items": [{ "key": "internal_ref", "defaultVisible": false }] }
          }
        }
      }
    },
    "SuitePings": {
      "_comment": "Has a location_id and must NOT be scoped: the explicit opt-out beats the column.",
      "location_bearing": false
    },
    "SuiteProformaInvoices": {
      "_comment": "A create wizard whose MIDDLE step is the inline-items table (`proforma_items` in a step's field_keys, exactly as a plain field would be). `total` is filled by the items table's `sync_to`, so it sits in the same step; a required field named by no step is never rendered and the create would 422. The Review & Confirm step is added after the last step and summarises the table as `N item(s)`.",
      "features": {
        "frontend": {
          "create": {
            "wizard": {
              "enabled": true,
              "steps": [
                { "title": "Customer", "field_keys": ["proforma_no", "customer_name", "currency", "valid_until"] },
                { "title": "Items", "field_keys": ["proforma_items", "total"] },
                { "title": "Notes", "field_keys": ["notes"] }
              ]
            }
          }
        }
      }
    },
    "SuiteKits": {
      "_comment": "An item-picker over a JSON column. The picker field is APPENDED (introspection produces no field for a JSON column); its catalog is a custom (static) splash source, which needs non-empty top-level `constants`; and json_rules names EVERY key of the stored row, because the picker saves the whole catalog item plus its own config fields and Laravel drops any nested key no rule names.",
      "constants": { "MAX_ITEMS": 20 },
      "json_rules": {
        "items": {
          "rules": {
            "*.id": "required|integer",
            "*.name": "required|string|max:120",
            "*.sku": "required|string|max:32",
            "*.quantity": "required|integer|min:1"
          },
          "sample": [{ "id": 1, "name": "Bolt", "sku": "B-1", "quantity": 2 }]
        }
      },
      "features": {
        "backend": {
          "createSplash": { "splashData": [{ "key": "catalog", "type": "custom", "paginate": false, "data": [
                  { "id": 1, "name": "Bolt", "sku": "B-1" },
                  { "id": 2, "name": "Nut", "sku": "N-1" },
                  { "id": 3, "name": "Washer 'M8'", "sku": "W-8" }
                ] }] },
          "editSplash": { "splashData": [{ "key": "catalog", "type": "custom", "paginate": false, "data": [
                  { "id": 1, "name": "Bolt", "sku": "B-1" },
                  { "id": 2, "name": "Nut", "sku": "N-1" },
                  { "id": 3, "name": "Washer 'M8'", "sku": "W-8" }
                ] }] }
        },
        "frontend": {
          "create": { "fields": { "$merge": "field", "$append": [{
              "field": "items",
              "key": "items",
              "label": "Items",
              "type": "item-picker",
              "field_type": "item-picker",
              "required": false,
              "availableItems": "catalog",
              "primaryField": "name",
              "availableItemsFields": [
                { "key": "name", "label": "Name", "type": "input" },
                { "key": "sku", "label": "SKU", "type": "input" }
              ],
              "configFields": [
                { "key": "quantity", "label": "Quantity", "type": "number", "required": true }
              ]
            }] } },
          "edit": { "fields": { "$merge": "field", "$append": [{
              "field": "items",
              "key": "items",
              "label": "Items",
              "type": "item-picker",
              "field_type": "item-picker",
              "required": false,
              "availableItems": "catalog",
              "primaryField": "name",
              "availableItemsFields": [
                { "key": "name", "label": "Name", "type": "input" },
                { "key": "sku", "label": "SKU", "type": "input" }
              ],
              "configFields": [
                { "key": "quantity", "label": "Quantity", "type": "number", "required": true }
              ]
            }] } }
        }
      }
    },
    "SuitePolicies": {
      "_comment": "A json column's shape (json_rules), STRING constants, and a form with no draft controls. `params` gets no form field from introspection, so the generated specs never send it: a nested `required` must be `sometimes|required`, or the generated create 422s. `sample` must be the complete accepted shape -- Laravel prunes any nested key no rule names.",
      "constants": { "STATE_ACTIVE": "ACTIVE", "STATE_PAUSED": "PAUSED" },
      "json_rules": {
        "params": {
          "rules": {
            "cap": "sometimes|required|integer|min:1|max:1000",
            "mode": "sometimes|required|in:soft,hard",
            "windows": "sometimes|array",
            "windows.*.start": "required|date_format:H:i",
            "windows.*.end": "required|date_format:H:i"
          },
          "sample": { "cap": 50, "mode": "soft", "windows": [{ "start": "08:00", "end": "17:00" }] }
        }
      },
      "features": { "frontend": { "create": { "drafts": false }, "edit": { "drafts": false } } }
    },
    "SuiteDocuments": {
      "_comment": "One processor per stage x operation. The class is module-overlays/SuiteDocuments/Services/SuiteDocumentsMarkerProcessor.php; it records what it was called with and changes nothing (the generated specs assert submitted == stored).",
      "processors": [
        { "stage": "before_save", "service": "SuiteDocumentsMarkerProcessor", "module": "SuiteDocuments", "operations": ["create", "edit"], "config": { "tag": "marker" } },
        { "stage": "after_save", "service": "SuiteDocumentsMarkerProcessor", "module": "SuiteDocuments", "operations": ["create", "edit"], "config": { "tag": "marker" } },
        { "stage": "before_delete", "service": "SuiteDocumentsMarkerProcessor", "module": "SuiteDocuments", "operations": ["delete"], "config": { "tag": "marker" } },
        { "stage": "after_delete", "service": "SuiteDocumentsMarkerProcessor", "module": "SuiteDocuments", "operations": ["delete"], "config": { "tag": "marker" } }
      ]
    },
    "SuiteTickets": {
      "_comment": "Bulk actions (generic + status_target), export/import, and a multi-step Create form: none has a blueprint key. status_target writes status_id = Model::DONE, so DONE must be a constant. A wizard partitions the form: a REQUIRED field named by no step is never rendered and the create 422s, so status_id is in step 1. A bulk action's variant is one of default | primary | danger.",
      "constants": { "OPEN": 1, "DONE": 2 },
      "features": {
        "backend": {
          "list": {
            "export": true,
            "import": true,
            "bulk_actions": [
              { "key": "archive", "label": "Archive", "icon": "Archive", "variant": "default", "confirmMessage": "Archive the selected tickets?" },
              { "key": "close", "label": "Close", "icon": "CheckCircle", "variant": "primary", "status_target": "DONE", "confirmMessage": "Close the selected tickets?" },
              { "key": "expedite", "label": "Expedite", "icon": "Zap", "variant": "danger", "confirmMessage": "Expedite the selected tickets? Blocked ones will fail." }
            ]
          }
        },
        "frontend": {
          "create": {
            "wizard": {
              "enabled": true,
              "steps": [
                { "title": "Basics", "field_keys": ["title", "status_id", "priority"] },
                { "title": "Assignment", "field_keys": ["assignee_id", "reason"] }
              ]
            }
          }
        }
      }
    }
  },

  "menu_config": {
    "sections": {
      "suite": { "label": "Super Suite", "icon": "FlaskConical", "order": 1 }
    }
  }
}
