        "import":  false,
        "export":  true,
        "endpoint": {
          "method":     "GET",
          "path":       "/products",
          "permission": "Products.list"
        }
      },
      "create": {
        "fields": [
          { "field": "name",        "rules": "required|string|max:255" },
          { "field": "code",        "rules": "required|string|max:50|unique:products,code" },
          { "field": "description", "rules": "nullable|string" },
          { "field": "price",       "rules": "required|numeric|min:0" },
          { "field": "is_active",   "rules": "boolean" },
          { "field": "category_id", "rules": "nullable|exists:categories,id" },
          { "field": "status_id",   "rules": "nullable|exists:statuses,id" }
        ],
        "endpoint": {
          "method":     "POST",
          "path":       "/products",
          "permission": "Products.create"
        }
      },
      "view": {
        "eagerLoadRelationships": ["category", "status"],
        "endpoint": {
          "method":     "GET",
          "path":       "/products/{uuid}",
          "permission": "Products.view"
        }
      },
      "edit": {
        "fields": [
          { "field": "name",        "rules": "required|string|max:255" },
          { "field": "code",        "rules": "required|string|max:50|unique:products,code,{uuid},uuid" },
          { "field": "description", "rules": "nullable|string" },
          { "field": "price",       "rules": "required|numeric|min:0" },
          { "field": "is_active",   "rules": "boolean" },
          { "field": "category_id", "rules": "nullable|exists:categories,id" },
          { "field": "status_id",   "rules": "nullable|exists:statuses,id" }
        ],
        "endpoint": {
          "method":     "PUT",
          "path":       "/products/{uuid}",
          "permission": "Products.edit"
        }
      },
      "delete": {
        "success_message": "Product deleted successfully.",
        "endpoint": {
          "method":     "DELETE",
          "path":       "/products/{uuid}",
          "permission": "Products.delete"
        }
      },
      "deleteCheck": {}
    },

