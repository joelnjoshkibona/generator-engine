  "features": {
    "backend": {
      "list": {
        "filterableFields":        ["name", "code", "is_active"],
        "sortableFields":          ["name", "price", "created_at"],
        "eagerLoadRelationships":  ["category", "status"],
        "filterableRelationships": [],
