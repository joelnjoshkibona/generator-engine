          { "field": "code",        "label": "Product Code",  "placeholder": "Enter SKU",           "required": true,  "field_type": "input",        "type": "text"    },
          { "field": "description", "label": "Description",   "placeholder": "Optional description", "required": false, "field_type": "textarea",     "type": "text"    },
          { "field": "price",       "label": "Price",         "placeholder": "0.00",                 "required": true,  "field_type": "number-input", "type": "number", "decimals": 2 },
          { "field": "is_active",   "label": "Active",        "placeholder": "",                     "required": false, "field_type": "checkbox",     "type": "boolean" },
          {
            "field":        "category_id",
