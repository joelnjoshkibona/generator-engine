{
  "_comment": "UX blueprint for make:ux-from-blueprint. CRITICAL: 'groups' only needs entries for modules used as a composite/shortcut host key (BaseUxGenerator::getGroupForModule() resolves group from here) -- keyed by group name, valued as a list of the module's snake_case table name. Wizard steps/triggers and shortcut/dashboard 'target'/'composite' all carry their own inline \"Group/ModuleName\" and don't need a groups entry. Remove _comment keys before use.",

  "groups": {
    "Custom": ["sales", "sale_items", "customers", "products", "payments"],
    "Core":   ["users", "statuses"]
  },

  "composites": {
    "Sales": {
      "label": "New Sale",
      "sections": [
        {
          "name":     "details",
          "type":     "form",
          "module":   "Custom/Sales",
          "optional": false
        },
        {
          "name":     "items",
          "type":     "repeater",
          "module":   "Custom/SaleItems",
          "optional": false
        }
      ]
    }
  },

  "wizards": {
    "SaleWizard": {
      "label": "New Sale Wizard",
      "steps": [
        {
          "step":   1,
          "name":   "customer",
          "label":  "Select Customer",
          "module": "Custom/Customers",
          "type":   "select_or_create"
        },
        {
          "step":   2,
          "name":   "items",
          "label":  "Add Items",
          "module": "Custom/SaleItems",
          "type":   "repeater"
        },
        {
          "step":   3,
          "name":   "payment",
          "label":  "Payment Details",
          "module": "Custom/Payments",
          "type":   "form"
        }
      ],
      "triggers_action": {
        "module": "Custom/Sales"
      }
    }
  },

  "shortcuts": {
    "Customers": [
      {
        "label":   "New Sale",
        "icon":    "ShoppingCart",
        "target":  "Custom/Sales",
        "wizard":  "SaleWizard",
        "prefill": { "customer_id": "$id" }
      },
      {
        "label":   "View Sales History",
        "icon":    "Receipt",
        "target":  "Custom/Sales",
        "wizard":  null,
        "prefill": {}
      }
    ],
    "Products": [
      {
        "label":   "New Sale with Product",
        "icon":    "ShoppingCart",
        "target":  "Custom/Sales",
        "wizard":  "SaleWizard",
        "prefill": { "product_id": "$id" }
      }
    ]
  },

  "dashboard": {
    "quick_actions": [
      {
        "label":     "New Sale",
        "icon":      "ShoppingCart",
        "composite": "Sales",
        "target":    "Custom/Sales",
        "wizard":    "SaleWizard"
      },
      {
        "label":     "Add Product",
        "icon":      "PackageCheck",
        "composite": null,
        "target":    "Custom/Products",
        "wizard":    null
      },
      {
        "label":     "Add Customer",
        "icon":      "UserPlus",
        "composite": null,
        "target":    "Custom/Customers",
        "wizard":    null
      }
    ]
  }
}
