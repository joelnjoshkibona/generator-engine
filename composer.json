{
    "name": "blutrixx/generator-engine",
    "description": "Module code generator engine for Laravel + Vue 3 + NativePHP Mobile. Generates backend modules, frontend pages, mobile backend with offline sync, and UX patterns (composites, wizards, shortcuts, dashboard) from a config-array specification.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "vue",
        "code-generator",
        "scaffolding",
        "module",
        "crud"
    ],
    "authors": [
        {
            "name": "Joel Kibona",
            "email": "ongezadev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Blutrixx\\GeneratorEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blutrixx\\GeneratorEngine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blutrixx\\GeneratorEngine\\GeneratorEngineServiceProvider"
            ]
        }
    },
    "version": "2.13.4",
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}