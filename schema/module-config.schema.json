{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blutrixx/generator-engine/schema/module-config.schema.json",
  "title": "Generator Engine Module Config",
  "description": "Schema for a single module configuration passed to blutrixx/generator-engine generators.",
  "type": "object",
  "required": [
    "module_name",
    "table_name",
    "columns",
    "features"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v5 derived from module_name. Auto-set by introspection."
    },
    "module_name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$",
      "description": "StudlyCase singular module name, e.g. 'Products'."
    },
    "module_type": {
      "type": "string",
      "enum": [
        "Custom",
        "Core"
      ],
      "default": "Custom",
      "description": "Affects namespace and output path."
    },
    "table_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Exact DB table name (snake_case plural), e.g. 'products'."
    },
    "id_type": {
      "type": "string",
      "enum": [
        "uuid",
        "bigint"
      ],
      "default": "uuid",
      "description": "Primary key type."
    },
    "module_group_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional sub-group label used in some menu groupings."
    },
    "skip_convention_check": {
      "type": "boolean",
      "default": false,
      "description": "PER-MODULE opt-out of SchemaIntrospector::meta()'s audit-column convention divergence check (see Blutrixx\\GeneratorEngine\\Schema\\SchemaConventions). By this project's convention, every generated table gets id/uuid/created_at/updated_at/deleted_at/created_by_id/updated_by_id automatically, so meta() always returns has_timestamps/has_soft_deletes/has_uuid/has_creator_updater = true and, when the live table already exists, throws SchemaConventionDivergenceException if any of those columns are actually missing. Set this to `true` ONLY for a genuine legacy/third-party table that deliberately does not follow this convention -- it silences the loud divergence check for that one table/module; it does NOT by itself change the returned has_* flags (pair it with explicit has_timestamps/has_soft_deletes/has_uuid/has_creator_updater overrides in the same config if the table's real layout differs from convention). Consumed entirely by SchemaIntrospector::meta() before this config is built -- it is not read by any generator."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "columns": {
      "type": "array",
      "description": "Column definitions. See docs/columns.md.",
      "items": {
        "$ref": "#/$defs/Column"
      }
    },
    "indexes": {
      "type": "array",
      "description": "Table-level (non-primary) indexes. Populated from live-DB introspection (SchemaIntrospector::indexGroups() via IntrospectionToConfig) or hand-authored. Single-column unique indexes are NOT expected here -- those are carried by the column's own `unique` flag instead; put multi-column uniques in `unique_constraints`.",
      "items": {
        "type": "object",
        "required": [
          "columns"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unique": {
            "type": "boolean",
            "default": false
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explicit index name. Auto-derived (and truncated/hashed if over MySQL's 64-char limit) by MigrationGenerator when omitted."
          }
        }
      }
    },
    "unique_constraints": {
      "type": "array",
      "description": "Composite (multi-column) unique constraints, rendered as $table->unique([...], name). Populated from live-DB introspection (SchemaIntrospector::indexGroups() via IntrospectionToConfig) or hand-authored. Single-column uniques belong on the column's own `unique` flag instead, never here.",
      "items": {
        "type": "object",
        "required": [
          "columns"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explicit constraint name. Auto-derived (and truncated/hashed if over MySQL's 64-char limit) by MigrationGenerator when omitted."
          }
        }
      }
    },
    "morphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type_column": {
            "type": "string"
          },
          "id_column": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "description": "Concrete models this morph column may point at. Never auto-guessed -- hand-authored. See docs/examples/morphs.md.",
            "items": {
              "type": "object",
              "required": ["alias", "model", "module", "label"],
              "properties": {
                "alias":         { "type": "string", "description": "Relation::morphMap() key stored in the type column, e.g. 'vendor'." },
                "model":         { "type": "string", "description": "Fully-qualified Model class this alias resolves to." },
                "module":        { "type": "string", "description": "StudlyCase module name (used to resolve the target's own generated file paths)." },
                "label":         { "type": "string" },
                "option_label":  { "type": "string", "description": "Which field of the target record to show in the create/edit record picker. Defaults to 'name'." },
                "delegate": {
                  "type": "object",
                  "description": "Optional. When enabled, generates a real MorphMany relation on this target's OWN Model (e.g. VendorsModel::payments()) plus a morph-filtered delegation tab on the target's own view page, showing the owning module's records where {type_column} = this alias and {id_column} = this record's id. See docs/examples/morphs.md.",
                  "properties": {
                    "enabled":       { "type": "boolean", "default": false },
                    "relation_name": { "type": "string", "description": "Method name for the MorphMany relation on the target's own Model, e.g. 'payments'. Defaults to the owning module's own table name if omitted." },
                    "tab_label":     { "type": "string", "description": "Label for the generated tab, e.g. 'Payments'." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "description": "Backend, frontend, and mobile_app feature config. See docs/features-config.md.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/BackendFeatures"
        },
        "frontend": {
          "$ref": "#/$defs/FrontendFeatures"
        },
        "mobile_app": {
          "$ref": "#/$defs/MobileAppFeatures"
        }
      }
    },
    "delegations": {
      "type": "array",
      "description": "Related-module tab/modal panels. See docs/delegations.md.",
      "items": {
        "$ref": "#/$defs/Delegation"
      }
    },
    "actions": {
      "type": "array",
      "description": "Custom action buttons. See docs/actions.md.",
      "items": {
        "$ref": "#/$defs/Action"
      }
    },
    "processors": {
      "type": "array",
      "description": "Pipeline lifecycle hooks. See docs/processors.md.",
      "items": {
        "$ref": "#/$defs/Processor"
      }
    },
    "seeder": {
      "type": "array",
      "description": "Seed rows. Keys must match column names.",
      "items": {
        "type": "object"
      }
    },
    "menu_config": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "section": {
          "type": "string"
        },
        "section_label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        },
        "nested": {
          "type": "boolean",
          "default": false
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MenuItem"
          }
        }
      }
    },
    "constants": {
      "type": "object",
      "description": "Flat map of CONSTANT_NAME -> scalar value, e.g. {\"RECEIVED\": 3}. Emitted verbatim as `public const {NAME} = {value};` on the generated Model (numeric values unquoted, everything else quoted as a PHP string). Read directly via ModelGenerator::generateConstants() -- this is NOT a nested {name, values:[{label,value}]} structure.",
      "additionalProperties": {
        "type": ["string", "number"]
      }
    }
  },
  "$defs": {
    "Column": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "text",
            "longText",
            "integer",
            "bigInteger",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "json",
            "foreignId",
            "uuid",
            "enum"
          ]
        },
        "relatedModule": {
          "type": "string",
          "default": ""
        },
        "length": {
          "type": "string",
          "default": ""
        },
        "precision": {
          "type": "integer",
          "description": "Total significant digits for a decimal/numeric column, e.g. 12 for decimal(12,4). Populated from live-DB introspection; MigrationGenerator falls back to 10 when absent on a decimal column."
        },
        "scale": {
          "type": "integer",
          "description": "Digits after the decimal point, e.g. 4 for decimal(12,4). Populated from live-DB introspection; MigrationGenerator falls back to 2 when absent on a decimal column."
        },
        "enum_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed values for an `enum`-typed column. Required (in practice) when type=\"enum\" -- MigrationGenerator renders $table->enum(name, enum_values)."
        },
        "default": {
          "type": "string",
          "default": ""
        },
        "unique": {
          "type": "boolean",
          "default": false
        },
        "nullable": {
          "type": "boolean",
          "default": false
        },
        "indexed": {
          "type": "boolean",
          "default": false,
          "description": "Informational: true if this column participates in any non-primary DB index (single- or multi-column). Actual $table->index(...) emission is driven by the top-level `indexes` array, not this flag."
        },
        "comment": {
          "type": "string",
          "default": ""
        },
        "featureSelections": {
          "type": "object",
          "properties": {
            "backend": {
              "$ref": "#/$defs/FeatureSelectionSet"
            },
            "frontend": {
              "$ref": "#/$defs/FeatureSelectionSet"
            }
          }
        }
      }
    },
    "FeatureSelectionSet": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "list": {
          "type": "boolean"
        },
        "view": {
          "type": "boolean"
        },
        "edit": {
          "type": "boolean"
        },
        "delete": {
          "type": "boolean"
        }
      }
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        }
      }
    },
    "BackendFeatures": {
      "type": "object",
      "properties": {
        "list": {
          "type": "object",
          "properties": {
            "filterableFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sortableFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "eagerLoadRelationships": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "filterableRelationships": {
              "type": "array"
            },
            "filterFields": {
              "type": "array"
            },
            "default_list_filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string"
                  },
                  "operator": {
                    "type": "string",
                    "default": "eq"
                  },
                  "value": {}
                }
              }
            },
            "bulk_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  }
                }
              }
            },
            "import": {
              "type": "boolean",
              "default": false
            },
            "export": {
              "type": "boolean",
              "default": false
            },
            "endpoint": {
              "$ref": "#/$defs/Endpoint"
            }
          }
        },
        "create": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ValidationField"
              }
            },
            "endpoint": {
              "$ref": "#/$defs/Endpoint"
            }
          }
        },
        "view": {
          "type": "object",
          "properties": {
            "eagerLoadRelationships": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "endpoint": {
              "$ref": "#/$defs/Endpoint"
            }
          }
        },
        "edit": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ValidationField"
              }
            },
            "endpoint": {
              "$ref": "#/$defs/Endpoint"
            }
          }
        },
        "delete": {
          "type": "object",
          "properties": {
            "success_message": {
              "type": "string"
            },
            "endpoint": {
              "$ref": "#/$defs/Endpoint"
            }
          }
        },
        "deleteCheck": {
          "type": "object"
        }
      }
    },
    "ValidationField": {
      "type": "object",
      "required": [
        "field",
        "rules"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "rules": {
          "type": "string"
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "FrontendFeatures": {
      "type": "object",
      "properties": {
        "list": {
          "type": "object",
          "properties": {
            "primaryField": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "sortable": {
                    "type": "boolean"
                  },
                  "data": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "boolean"
                    ]
                  },
                  "class": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "create": {
          "$ref": "#/$defs/FrontendMutateFeature"
        },
        "edit": {
          "$ref": "#/$defs/FrontendMutateFeature"
        },
        "view": {
          "type": "object",
          "properties": {
            "titleData": {
              "type": "string"
            },
            "idParam": {
              "type": "string",
              "default": "uuid"
            },
            "badges": {
              "type": "array"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "data": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "boolean"
                    ]
                  },
                  "format": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "delete": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "FrontendMutateFeature": {
      "type": "object",
      "properties": {
        "button_text": {
          "type": "string"
        },
        "sections": {
          "type": "array"
        },
        "hiddens": {
          "type": "array"
        },
        "defaults": {
          "type": "array"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrontendField"
          }
        },
        "drafts": {
          "type": "boolean",
          "default": true,
          "description": "Wires the generic Core/Drafts \"Save as Draft\" autosave (banner + button + server-side persistence) into this Create/Edit form. On by default -- set false to opt a module out (e.g. a tiny lookup-table form where drafting adds no value)."
        },
        "wizard": {
          "$ref": "#/$defs/WizardConfig",
          "description": "Optional multi-step presentation of `fields` above. See WizardConfig."
        }
      }
    },
    "FrontendField": {
      "type": "object",
      "required": [
        "field",
        "label",
        "field_type"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "field_type": {
          "type": "string",
          "enum": [
            "input",
            "textarea",
            "number-input",
            "checkbox",
            "date",
            "api-select"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "number",
            "boolean",
            "date"
          ]
        },
        "api_url": {
          "type": "string"
        },
        "option_label": {
          "type": "string"
        },
        "option_value": {
          "type": "string"
        },
        "per_page": {
          "type": "number"
        },
        "multiple": {
          "type": "boolean"
        },
        "decimals": {
          "type": "number"
        },
        "splashKey": {
          "type": "string"
        }
      }
    },
    "MobileAppFeatures": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "online",
            "offline",
            "both"
          ],
          "default": "online"
        },
        "icon": {
          "type": "string",
          "default": "LayersIcon"
        },
        "list": {
          "type": "object",
          "properties": {
            "card": {
              "type": "object",
              "properties": {
                "icon": {
                  "type": "string"
                },
                "titleField": {
                  "type": "string"
                },
                "subtitleFields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "bodyFields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "footerBadge": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "Delegation": {
      "type": "object",
      "required": [
        "name",
        "relatedModule"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "uiType": {
          "type": "string",
          "enum": [
            "tab",
            "modal"
          ],
          "default": "tab"
        },
        "relatedModule": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "group": {
                  "type": "string",
                  "default": "Core"
                }
              }
            }
          ]
        },
        "parentKey": {
          "type": "string",
          "default": "uuid"
        },
        "filterKey": {
          "type": "string",
          "default": "parent_id"
        },
        "parentIdField": {
          "type": "string",
          "default": "id"
        },
        "defaults": {
          "type": "array"
        },
        "operations": {
          "type": "object",
          "properties": {
            "list": {
              "$ref": "#/$defs/DelegationOperation"
            },
            "create": {
              "$ref": "#/$defs/DelegationOperation"
            },
            "edit": {
              "$ref": "#/$defs/DelegationOperation"
            },
            "view": {
              "$ref": "#/$defs/DelegationOperation"
            },
            "delete": {
              "$ref": "#/$defs/DelegationOperation"
            }
          }
        }
      }
    },
    "DelegationOperation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "endpoint": {
          "$ref": "#/$defs/Endpoint"
        },
        "backend": {
          "type": "object"
        },
        "frontend": {
          "type": "object"
        }
      }
    },
    "Action": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "placement": {
          "type": "string",
          "enum": [
            "main",
            "more"
          ],
          "default": "more",
          "description": "Where the action's button renders in the view modal footer. 'main' sits beside Edit as a primary button; 'more' becomes an item in the More actions dropdown. Defaults to 'more' so a new action never crowds the primary row."
        },
        "icon": {
          "type": "string",
          "description": "lucide-vue-next icon name, e.g. MailIcon. Rendered in the button/menu item."
        },
        "destructive": {
          "type": "boolean",
          "default": false,
          "description": "Style the More actions item as destructive (red), like Delete."
        },
        "hasUI": {
          "type": "boolean",
          "default": false
        },
        "uiType": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "modal",
            "page",
            null
          ]
        },
        "urlParams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "methodName": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "operations": {
          "type": "object",
          "properties": {
            "list": {
              "$ref": "#/$defs/ActionOperation"
            },
            "create": {
              "$ref": "#/$defs/ActionOperation"
            },
            "edit": {
              "$ref": "#/$defs/ActionOperation"
            },
            "view": {
              "$ref": "#/$defs/ActionOperation"
            },
            "delete": {
              "$ref": "#/$defs/ActionOperation"
            }
          }
        },
        "fields": {
          "type": "array",
          "description": "Form fields for the action's own UI (only meaningful when hasUI is true). Same shape as create/edit fields[] -- see FrontendField.",
          "items": {
            "$ref": "#/$defs/FrontendField"
          }
        },
        "wizard": {
          "$ref": "#/$defs/WizardConfig",
          "description": "Optional multi-step presentation of `fields` above. See WizardConfig."
        }
      }
    },
    "ActionOperation": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "endpoint": {
          "$ref": "#/$defs/Endpoint"
        }
      }
    },
    "WizardConfig": {
      "type": "object",
      "description": "Optional multi-step presentation of a create/edit form's or action's fields[]. Additive/opt-in -- omitting this key (or enabled:false) generates byte-identical output to a flat form. See docs/changelog.md v3.1.0.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "submission_mode": {
          "type": "string",
          "enum": ["final", "per_step"],
          "default": "final",
          "description": "Only 'final' is implemented: steps gate visible fields, one real submit at the end, identical backend/API shape to a non-wizard form. 'per_step' (a true partial-commit backend primitive) is reserved, not implemented -- no existing precedent to build it against safely yet."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WizardStep"
          }
        }
      }
    },
    "WizardStep": {
      "type": "object",
      "required": ["id", "label", "field_keys"],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "lucide-vue-next icon name, e.g. FileTextIcon."
        },
        "field_keys": {
          "type": "array",
          "description": "References already-defined fields[].field (or fields[].key) values -- no duplicate field definitions. Also matches against inline_items[].key, so an inline-items block (e.g. line items) can be its own step.",
          "items": {
            "type": "string"
          }
        },
        "skip_if": {
          "type": "string",
          "description": "Optional condition expression, mirrors the Delegation modal's own step skip idiom. Not yet consumed by any generator -- reserved for a future conditional-step pass."
        }
      }
    },
    "Processor": {
      "type": "object",
      "description": "Only before_save/after_save/before_delete/after_delete actually fire (each mapped 1:1 to a static {Str::camel(stage)} method call) -- before_validation/after_validation are not implemented by any generator and silently produce zero generated code. There is no 'method' key: the invoked method name is always derived from 'stage', never configurable. 'module' is required and does not need to already be a scaffolded module (falls back to App\\Project\\Modules\\Core\\{module} with a warning if unresolvable). See docs/processors.md.",
      "required": [
        "stage",
        "service",
        "module"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "before_save",
            "after_save",
            "before_delete",
            "after_delete"
          ]
        },
        "service": {
          "type": "string"
        },
        "module": {
          "type": "string",
          "description": "StudlyCase module name the processor's namespace is resolved against."
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "create",
              "edit",
              "delete"
            ]
          }
        },
        "fields": {
          "type": "array",
          "description": "Optional. Passed through verbatim as the processor method's 3rd argument."
        },
        "config": {
          "type": "object",
          "description": "Optional. Passed through verbatim as the processor method's 4th argument."
        }
      }
    },
    "MenuItem": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "permission": {},
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MenuItem"
          }
        }
      }
    }
  }
}
