{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blutrixx/generator-engine/schema/scaffold-blueprint.schema.json",
  "title": "Generator Engine Scaffold Blueprint",
  "description": "Schema for the blueprint JSON consumed by make:modules-from-db, make:mobile-modules, and make:mobile-scaffold.",
  "type": "object",
  "required": ["groups"],
  "additionalProperties": true,

  "properties": {

    "id_type": {
      "type": "string",
      "enum": ["uuid", "bigint"],
      "description": "Default primary key type applied to all modules when a table doesn't set its own. This schema does not enforce a default when the key is omitted entirely -- each consuming project's own make:modules-from-db command applies its own fallback (e.g. SYSTEM_SHELL's defaults to 'bigint'; do not assume 'uuid' project-to-project). Set this key explicitly rather than relying on an implicit default."
    },

    "groups": {
      "type": "object",
      "description": "Maps group names to arrays of DB table names. Tables in the empty-string group are skipped.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "examples": [
        {
          "Custom": ["products", "categories"],
          "Core":   ["users", "roles"],
          "":       ["migrations", "password_reset_tokens"]
        }
      ]
    },

    "morphs": {
      "type": "array",
      "description": "Polymorphic relationship declarations.",
      "items": {
        "type": "object",
        "required": ["table", "name"],
        "properties": {
          "table":   { "type": "string", "description": "DB table owning the morph columns." },
          "name":    { "type": "string", "description": "Base morph name, e.g. 'reference' → reference_type + reference_id." },
          "targets": { "type": "array", "items": { "type": "string" }, "description": "Optional model class names that morph to this table." }
        }
      }
    },

    "foreign_key_graph": {
      "type": "object",
      "description": "Reverse FK map. Keys are target tables; values list the tables/columns pointing at them. Used for topological sort and delete-check generation.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["source_table", "source_column"],
          "properties": {
            "source_table":  { "type": "string" },
            "source_column": { "type": "string" }
          }
        }
      }
    },

    "delegations": {
      "type": "object",
      "description": "Per-module delegation config. Keys are StudlyCase module names. See docs/delegations.md.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/BlueprintDelegation" }
      }
    },

    "menu_config": {
      "type": "object",
      "description": "Global navigation config.",
      "properties": {
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "icon":  { "type": "string" },
              "order": { "type": "number" }
            }
          }
        },
        "modules": {
          "type": "object",
          "description": "Per-module menu overrides. Keys are StudlyCase module names.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "hidden":  { "type": "boolean" },
              "label":   { "type": "string" },
              "icon":    { "type": "string" },
              "section": { "type": "string" },
              "order":   { "type": "number" }
            }
          }
        }
      }
    },

    "seeders": {
      "type": "object",
      "description": "Per-module seed rows. Keys are StudlyCase module names; values are arrays of row objects.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "object" }
      }
    },

    "actions": {
      "type": "object",
      "description": "Per-module custom action definitions. Keys are StudlyCase module names. See docs/actions.md.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/BlueprintAction" }
      }
    },

    "inline_items": {
      "type": "object",
      "description": "Per-module inline item sections managed inside the parent's Create/Edit forms via InlineItemsComponent. Keys are StudlyCase parent module names.",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/InlineItemConfig" }
      }
    }
  },

  "$defs": {

    "Endpoint": {
      "type": "object",
      "properties": {
        "method":     { "type": "string", "enum": ["GET","POST","PUT","PATCH","DELETE"] },
        "path":       { "type": "string" },
        "permission": { "type": "string" }
      }
    },

    "BlueprintDelegation": {
      "type": "object",
      "required": ["name", "relatedModule"],
      "properties": {
        "name":   { "type": "string" },
        "label":  { "type": "string" },
        "uiType": { "type": "string", "enum": ["tab", "modal"], "default": "tab" },
        "relatedModule": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name":  { "type": "string" },
                "group": { "type": "string" }
              }
            }
          ]
        },
        "parentKey":   { "type": "string" },
        "filterKey":   { "type": "string" },
        "defaults":    { "type": "array" },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled":  { "type": "boolean" },
              "endpoint": { "$ref": "#/$defs/Endpoint" }
            }
          }
        }
      }
    },

    "BlueprintAction": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name":      { "type": "string" },
        "label":     { "type": "string" },
        "hasUI":     { "type": "boolean" },
        "uiType":    { "type": ["string", "null"] },
        "urlParams": { "type": "array", "items": { "type": "string" } },
        "operations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled":  { "type": "boolean" },
              "endpoint": { "$ref": "#/$defs/Endpoint" }
            }
          }
        }
      }
    },

    "InlineItemConfig": {
      "type": "object",
      "required": ["key", "child_module", "child_group", "parent_fk", "primary_field", "fields"],
      "properties": {
        "key":              { "type": "string",  "description": "Form payload key and v-model binding, e.g. 'line_items'." },
        "label":            { "type": "string",  "description": "Section label shown above the InlineItemsComponent." },
        "child_module":     { "type": "string",  "description": "StudlyCase name of the child module, e.g. 'OrderItems'." },
        "child_group":      { "type": "string",  "description": "Group of the child module, e.g. 'Custom'. Used to build the model namespace." },
        "parent_fk":        { "type": "string",  "description": "Column on the child table that stores the parent record's id, e.g. 'order_id'." },
        "primary_field":    { "type": "string",  "description": "Field key shown in the delete confirmation (primaryField prop on InlineItemsComponent)." },
        "modal_size":       { "type": "string",  "enum": ["sm","md","lg","xl","2xl"], "default": "md" },
        "modal_columns":    { "type": "integer", "enum": [1, 2], "default": 1 },
        "add_button_text":  { "type": "string",  "default": "Add Item" },
        "add_modal_title":  { "type": "string",  "default": "Add Item" },
        "edit_modal_title": { "type": "string",  "default": "Edit Item" },
        "view_modal_title": { "type": "string",  "default": "View Item" },
        "inject_from_parent": {
          "type": "array",
          "description": "Additional fields to copy from the parent model into every child record on create/edit. parent_fk is already injected automatically and should not be listed here.",
          "items": {
            "type": "object",
            "required": ["child_field", "parent_field"],
            "properties": {
              "child_field":  { "type": "string", "description": "Column name on the child table." },
              "parent_field": { "type": "string", "description": "Attribute name on the parent model to read from, e.g. 'company_id'." }
            }
          }
        },
        "fields": {
          "type": "array",
          "description": "Field definitions for the InlineItemsComponent form and table columns.",
          "items": { "$ref": "#/$defs/InlineItemField" }
        }
      }
    },

    "InlineItemField": {
      "type": "object",
      "required": ["key", "label", "type"],
      "properties": {
        "key":           { "type": "string" },
        "label":         { "type": "string" },
        "type":          { "type": "string", "enum": ["input","textarea","select","api-select","date","checkbox","number-input"] },
        "required":      { "type": "boolean", "default": false },
        "splash_key":    { "type": "string",  "description": "Auto-builds /select/{SplashKey} API URL for api-select fields." },
        "api_url":       { "type": "string",  "description": "Explicit API URL for api-select fields (overrides splash_key)." },
        "table_width":   { "type": "string",  "description": "Width hint for the table column header, e.g. '100px'." },
        "show_in_table": { "type": "boolean", "default": true },
        "decimals":      { "type": "integer", "description": "Decimal places for number-input type." },
        "col_span":      { "type": "integer", "enum": [1, 2], "description": "Column span in the modal grid when modal_columns=2." },
        "placeholder":   { "type": "string" },
        "default":       { "description": "Initial field value when a new row modal is opened." }
      }
    }
  }
}
