<template>
	<FormPageLayout title="Delete [[ModuleName]]" :backTo="backLink">
		<[[ModuleName]]DeleteForm :uuid="uuid" :cancel-link="backLink" />
	</FormPageLayout>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { useRoute } from 'vue-router'
import FormPageLayout from '@/layouts/FormPageLayout.vue'
import [[ModuleName]]DeleteForm from './Components/[[ModuleName]]DeleteForm.vue'

const route = useRoute()
const uuid = computed(() => route.params.uuid as string)
const backLink = computed(() => (route.query.back as string) || `/[[moduleRoute]]/${uuid.value}/overview`)
</script>
