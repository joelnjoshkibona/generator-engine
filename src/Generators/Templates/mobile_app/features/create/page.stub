<template>
	<AppShell title="Create [[ModuleName]]" :back-to="backLink" show-back>
		<div class="max-w-2xl mx-auto w-full py-4 px-1 space-y-4">
			<[[ModuleName]]CreateForm :defaults="queryDefaults" :cancel-link="backLink" />
		</div>
	</AppShell>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { useRoute } from 'vue-router'
import AppShell from '@/components/layout/AppShell.vue'
import [[ModuleName]]CreateForm from './Components/[[ModuleName]]CreateForm.vue'

const route = useRoute()

const queryDefaults = computed(() => {
	const defaults: Record<string, any> = {}
	const query = route.query
	Object.keys(query).forEach(key => {
		if (key !== 'back' && query[key]) {
			const value = query[key] as string
			defaults[key] = /^\d+$/.test(value) ? parseInt(value, 10) : value
		}
	})
	return defaults
})

const backLink = computed(() => (route.query.back as string) || '/[[moduleRoute]]/list')
</script>
