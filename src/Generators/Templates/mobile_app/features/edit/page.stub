<template>
	<AppShell :title="'Edit ' + entityTitle" :back-to="backLink" show-back>
		<div class="max-w-2xl mx-auto w-full py-4 px-1 space-y-4">
			<[[ModuleName]]EditForm :uuid="uuid" :cancel-link="backLink" />
		</div>
	</AppShell>
</template>

<script lang="ts">
export default {
	name: '[[ModuleName]]EditPage',
}
</script>

<script setup lang="ts">
import { computed } from 'vue'
import { useRoute } from 'vue-router'
import AppShell from '@/components/layout/AppShell.vue'
import [[ModuleName]]EditForm from './Components/[[ModuleName]]EditForm.vue'

const route = useRoute()
const uuid = route.params.uuid as string
const entityTitle = computed(() => '[[ModuleName]]')
const backLink = computed(() => (route.query.back as string) || `/[[moduleRoute]]/${uuid}`)
</script>
