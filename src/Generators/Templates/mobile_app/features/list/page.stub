 * vars), where MainLayout's fixed nav relies on raw CSS env() alone, which
 * does not resolve on the Android WebView and left the header clipped under
 * the status bar. ListPageBareCards owns its own sticky action/toolbar row
 * inside AppShell's scrolling <main>, matching the Agrovet reference app's
 * list-page pattern -- only the item cards scroll, Create/Refresh/Filter/
 * Sort/Columns stay pinned above them.
 */
import AppShell from "@/components/layout/AppShell.vue";
