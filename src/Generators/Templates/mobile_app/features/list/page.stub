<script setup lang="ts">
/**
 * [[ModuleName]]ListPage.vue
 *
 * List page for viewing all [[moduleName]] with filtering and pagination.
 *
 * API Endpoint: /[[moduleRoute]]/list (WITH leading slash)
 *
 * Uses AppShell (not the legacy MainLayout) -- AppShell's AppHeader bridges
