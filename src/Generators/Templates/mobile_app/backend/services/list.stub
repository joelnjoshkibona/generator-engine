<?php

namespace App\Modules\[[moduleGroup]]\[[moduleName]]\Services;

use App\Modules\[[moduleGroup]]\[[moduleName]]\[[moduleName]]Model;

class [[moduleName]]ListService
{
    public function handle(array $params = []): array
    {
        $query = [[moduleName]]Model::query();

        $search = $params['search'] ?? null;
        if ($search) {
            $query->where(function ($q) use ($search) {
[[searchableFields]]
            });
        }

        $perPage = (int) ($params['per_page'] ?? 15);
        $page = (int) ($params['page'] ?? 1);

        $results = $query->orderBy('created_at', 'desc')->paginate($perPage, ['*'], 'page', $page);

        return [
            'status'  => true,
            'data'    => $results->items(),
            'meta'    => [
                'current_page' => $results->currentPage(),
                'last_page'    => $results->lastPage(),
                'per_page'     => $results->perPage(),
                'total'        => $results->total(),
            ],
            'message' => 'Records retrieved.',
        ];
    }
}
