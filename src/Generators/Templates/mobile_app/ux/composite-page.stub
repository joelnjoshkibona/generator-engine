<script lang="ts">
export default {
	name: '[[ModuleName]]CreatePage',
}
</script>

<script setup lang="ts">
import { ref } from 'vue'
import { useRouter } from 'vue-router'
import FormPageLayout from '@/layouts/FormPageLayout.vue'
import FormCard from '@/components/form/FormCard.vue'
import FormSubmitActions from '@/components/form/FormSubmitActions.vue'
import { toast } from '@/lib/toast'
import { sendPostRequest } from '@/helpers'
[[sectionImports]]

const router = useRouter()
const isSubmitting = ref(false)
const activeSection = ref('[[firstSection]]')

// One data object per section — arrays for repeaters, objects for forms
[[sectionDataRefs]]

const sections = [[sectionsConfig]]

async function handleSubmit() {
	isSubmitting.value = true
	try {
		const result = await sendPostRequest('/[[apiEndpoint]]', {
[[sectionPayload]]
		})
		if (result?.status) {
			toast.success(result.message ?? '[[Label]] created successfully')
			router.back()
		} else {
			toast.error(result?.message ?? 'An error occurred')
		}
	} catch {
		toast.error('An error occurred')
	} finally {
		isSubmitting.value = false
	}
}
</script>

<template>
	<FormPageLayout title="[[Label]]" back-to="/[[moduleRoute]]">
		<div class="space-y-2">
			<!-- Section tabs -->
			<div class="flex gap-1 overflow-x-auto pb-1">
				<button
					v-for="section in sections"
					:key="section.name"
					type="button"
					@click="activeSection = section.name"
					:class="['shrink-0 px-3 py-1.5 text-xs font-medium rounded-full transition-colors',
						activeSection === section.name
							? 'bg-primary text-primary-foreground'
							: 'bg-muted text-muted-foreground active:opacity-70']">
					{{ section.label }}
					<span v-if="section.optional" class="ml-1 opacity-60">(opt)</span>
				</button>
			</div>

			<!-- Active section label -->
			<p class="text-xs font-semibold text-muted-foreground px-1">
				{{ sections.find(s => s.name === activeSection)?.label }}
			</p>

			<!-- Section panels -->
			<FormCard>
[[sectionPanels]]
			</FormCard>

			<form @submit.prevent="handleSubmit">
				<FormSubmitActions
					:is-submitting="isSubmitting"
					submit-label="Create [[Label]]"
					loading-label="Creating..."
					@cancel="router.back()"
				/>
			</form>
		</div>
	</FormPageLayout>
</template>
