<script lang="ts">
export default {
	name: '[[PrimaryModule]]WizardPage',
}
</script>

<script setup lang="ts">
import { ref, computed } from 'vue'
import { useRouter } from 'vue-router'
import FormPageLayout from '@/layouts/FormPageLayout.vue'
import FormCard from '@/components/form/FormCard.vue'
import { toast } from '@/lib/toast'
import { sendPostRequest } from '@/helpers'
[[stepImports]]

const router = useRouter()
const isSubmitting = ref(false)
const currentStep = ref(1)

const steps = [[stepsConfig]]

const stepData = ref<Record<string, Record<string, any>>>(
	Object.fromEntries(steps.map(s => [`step_${s.step}`, {}]))
)

const isFirstStep = computed(() => currentStep.value === 1)
const isLastStep = computed(() => currentStep.value === steps.length)
const currentStepConfig = computed(() => steps[currentStep.value - 1])

async function goNext() {
	isSubmitting.value = true
	try {
		const result = await sendPostRequest(`/wizards/[[wizard-name]]/step/${currentStep.value}`, stepData.value[`step_${currentStep.value}`] ?? {})
		if (result?.status) {
			stepData.value[`step_${currentStep.value}`] = result.data ?? stepData.value[`step_${currentStep.value}`]
			if (!isLastStep.value) currentStep.value++
		} else {
			toast.error(result?.message ?? 'Validation failed')
		}
	} catch {
		toast.error('Validation failed')
	} finally {
		isSubmitting.value = false
	}
}

function goBack() {
	if (!isFirstStep.value) currentStep.value--
}

async function handleCommit() {
	isSubmitting.value = true
	try {
		const result = await sendPostRequest('/wizards/[[wizard-name]]/commit', stepData.value)
		if (result?.status) {
			toast.success(result.message ?? '[[Label]] completed successfully')
			router.back()
		} else {
			toast.error(result?.message ?? 'An error occurred')
		}
	} catch {
		toast.error('An error occurred')
	} finally {
		isSubmitting.value = false
	}
}
</script>

<template>
	<FormPageLayout title="[[Label]]" back-to="/">
		<div class="space-y-2">
			<!-- Step progress -->
			<div class="flex items-center overflow-x-auto gap-1 py-1">
				<template v-for="(step, idx) in steps" :key="step.name">
					<div :class="['flex items-center gap-1.5 text-xs whitespace-nowrap',
						currentStep > idx + 1 ? 'text-primary' :
						currentStep === idx + 1 ? 'text-foreground font-semibold' :
						'text-muted-foreground']">
						<span :class="['w-5 h-5 rounded-full flex items-center justify-center text-[10px] border shrink-0',
							currentStep > idx + 1 ? 'bg-primary text-primary-foreground border-primary' :
							currentStep === idx + 1 ? 'border-primary text-primary' :
							'border-muted-foreground text-muted-foreground']">
							{{ idx + 1 }}
						</span>
						{{ step.label }}
					</div>
					<div v-if="idx < steps.length - 1" class="flex-1 h-px bg-border min-w-3 shrink-0" />
				</template>
			</div>

			<!-- Step label -->
			<p class="text-xs font-semibold text-muted-foreground px-1">{{ currentStepConfig.label }}</p>

			<!-- Step panel -->
			<FormCard>
[[stepPanels]]
			</FormCard>

			<!-- Navigation -->
			<div class="flex gap-2">
				<button
					v-if="!isFirstStep"
					type="button"
					@click="goBack"
					:disabled="isSubmitting"
					class="flex-1 py-2.5 text-sm border rounded-lg disabled:opacity-40 active:opacity-70">
					Back
				</button>
				<button
					v-if="!isLastStep"
					type="button"
					@click="goNext"
					:disabled="isSubmitting"
					class="flex-1 py-2.5 text-sm bg-primary text-primary-foreground rounded-lg disabled:opacity-50 active:opacity-80">
					{{ isSubmitting ? 'Validating...' : 'Next' }}
				</button>
				<button
					v-else
					type="button"
					@click="handleCommit"
					:disabled="isSubmitting"
					class="flex-1 py-2.5 text-sm bg-primary text-primary-foreground rounded-lg disabled:opacity-50 active:opacity-80">
					{{ isSubmitting ? 'Completing...' : 'Complete [[Label]]' }}
				</button>
			</div>
		</div>
	</FormPageLayout>
</template>
