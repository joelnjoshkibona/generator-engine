<script lang="ts">
export default {
	name: 'ModuleShortcuts',
}
</script>

<script setup lang="ts">
import { useRouter } from 'vue-router'
import * as icons from 'lucide-vue-next'

const props = defineProps<{
	record: Record<string, any>
}>()

const router = useRouter()

const shortcuts = [[shortcutsConfig]]

function navigate(shortcut: (typeof shortcuts)[number]) {
	if (shortcut.wizard) {
		router.push({ name: shortcut.wizard, query: buildQuery(shortcut.prefill) })
	} else if (shortcut.target) {
		router.push({ name: shortcut.routeName, query: buildQuery(shortcut.prefill) })
	}
}

function buildQuery(prefill: Record<string, string>) {
	const query: Record<string, string> = {}
	for (const [key, val] of Object.entries(prefill)) {
		query[key] = val === '$id'
			? props.record?.id
			: val === '$uuid'
				? props.record?.uuid
				: val.startsWith('$')
					? props.record?.[val.slice(1)]
					: val
	}
	return query
}
</script>

<template>
	<div class="flex gap-2 overflow-x-auto pb-1">
		<button
			v-for="shortcut in shortcuts"
			:key="shortcut.label"
			type="button"
			@click="navigate(shortcut)"
			class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium bg-muted rounded-lg active:opacity-70 transition-opacity">
			<component
				v-if="shortcut.icon && (icons as any)[shortcut.icon]"
				:is="(icons as any)[shortcut.icon]"
				class="h-3.5 w-3.5 shrink-0"
			/>
			{{ shortcut.label }}
		</button>
	</div>
</template>
