<template>
	<div v-if="isLoading" class="flex justify-center items-center h-64">
		<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
	</div>
	<form v-else @submit.prevent="handleSubmit" class="space-y-6">
		[[formSections]]

		<!-- Form Actions -->
		<div class="flex justify-end space-x-3 pt-4 border-t">
			<Button
				type="button"
				variant="outline"
				@click="cancel"
				:disabled="isSubmitting"
			>
				Cancel
			</Button>
			<Button
				type="submit"
				:disabled="isSubmitting"
				:class="{ 'opacity-50 cursor-not-allowed': isSubmitting }"
			>
				<component :is="icons['Loader2Icon']" v-if="isSubmitting" class="h-3 w-3 mr-2 animate-spin" />
				{{ isSubmitting ? 'Updating...' : 'Update [[ModuleName]]' }}
			</Button>
		</div>
	</form>
</template>

<script lang="ts">
export default {
	name: '[[ModuleName]]EditForm',
}
</script>

<script setup lang="ts">
import * as icons from "lucide-vue-next";
import {Button} from "@/components/ui/button";
import {onMounted, ref, computed} from "vue";
import {sendGetRequest, sendPutRequest} from "@/helpers.ts";
import {toast} from "@/lib/toast.ts";
import { Card, CardHeader, CardContent, CardFooter } from "@/components/ui/card";
import { colorClasses } from "@/styles/colors";
[[formFieldImports]]

const colors = computed(() => colorClasses['default'])

const props = defineProps<{
	uuid: string
	parentUuid: string
	hiddens?: Record<string, boolean>
	defaults?: Record<string, any>
	submitUrl?: string
	splashUrl?: string
	viewUrl?: string
	successMessage?: string
}>()
const emit = defineEmits(['success', 'cancel'])

// Computed endpoints with fallbacks
const submitEndpoint = computed(() => {
	if (props.submitUrl) {
		return props.submitUrl
	}
	// Use template literal from backend generator
	return `[[submitEndpoint]]`
})

const splashEndpoint = computed(() => {
	if (props.splashUrl) {
		return props.splashUrl
	}
	// Use template literal from backend generator
	return `[[splashEndpoint]]`
})

const viewEndpoint = computed(() => {
	if (props.viewUrl) {
		return props.viewUrl
	}
	// Use template literal from backend generator
	return `[[viewEndpoint]]`
})

// Form data
const form = ref({
[[formFields]]
} as Record<string, any>)

// Form state
const isSubmitting = ref(false)
const isLoading = ref(true)
const errors = ref<Record<string, string>>({})
const hasSplash = [[hasSplash]]

// Options for select fields
const splash = ref<Record<string, any>>({
	[[splashData]]
})

// Submit form handler
const handleSubmit = async () => {
	try {
		isSubmitting.value = true
		errors.value = {}
		const response = await sendPutRequest(submitEndpoint.value, { ...form.value })
		if (response.status) {
			toast.success(props.successMessage || '[[ModuleName]] updated successfully')
			emit('success', response.data)
		} else {
			if (response.errors) {
				errors.value = response.errors
				toast.error('Please fix the validation errors and try again.')
			} else {
				toast.error(response.message || 'Failed to update [[ModuleName]]')
			}
		}
	} catch (error) {
		console.error('Error updating [[ModuleName]]:', error)
		toast.error('Failed to update [[ModuleName]]. Please try again.')
	} finally {
		isSubmitting.value = false
	}
}

const cancel = () => {
	emit('cancel')
}

// Use this to build external data for selection while you are still on this page.
// Special use case in select fields.
async function refreshAndSet(key: string|null = null, value: any|null = null) {
    if(!hasSplash) {
		isLoading.value = false
		return;
	}
    // Guard: never fire splash with a missing parent context.
    // Parent details page may still be loading when the modal opens.
    if (!props.parentUuid || props.parentUuid === 'undefined') {
        isLoading.value = false
        return;
    }
    isLoading.value = true
    const response = await sendGetRequest(splashEndpoint.value)
    if (response.status) {
        splash.value = response.data
		if(key != null && value != null) (form.value as any)[key] = value
    } else {
        toast.error('Failed to load form data. Please refresh the page.')
    }
    isLoading.value = false
}

// Load reference data and form data
onMounted(async () => {
	await refreshAndSet()
	
	// Load existing data
	isLoading.value = true
	const response = await sendGetRequest(viewEndpoint.value)
	if (response.status) {
		form.value = { ...form.value, ...response.data }
		// Apply defaults from props (overrides loaded data if needed)
		if (props.defaults && Object.keys(props.defaults).length > 0) {
			form.value = { ...form.value, ...props.defaults }
		}
	} else {
		toast.error('Failed to load [[ModuleName]] data. Please refresh the page.')
	}
	isLoading.value = false
})
</script>

<style scoped>
</style>

