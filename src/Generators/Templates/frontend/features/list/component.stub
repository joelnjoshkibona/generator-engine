<template>
	<ListTable
		ref="listRef"
		:endpoint="apiEndpoint"
		:columns="columns"
		:filter-fields="filterFields"
		:enable-export="[[enableExport]]"
		:enable-bulk-actions="hasPermission('[[PermissionBaseName]].bulkAction')"
		:bulk-actions="bulkActions"
		mode="history"
		@data-loaded="handleDataLoaded"
	>
		<template #toolbar-start>
			<slot name="toolbar-prepend" />
		</template>
		<template #toolbar-actions>
			<slot name="toolbar-append" />
		</template>

		<!-- Actions Column -->
		<template #cell-actions="{ row }">
			<div class="flex justify-end space-x-2">
				<router-link :to="`/[[moduleRoute]]/${row.uuid}/details`" v-if="hasPermission('[[PermissionBaseName]].view')">
					<Button variant="outline" size="xs">
						<component :is="icons['EyeIcon']" class="h-3 w-3 mr-1" />
						{{ $t('common.view') }}
					</Button>
				</router-link>
			</div>
		</template>

		<!-- Primary cell with responsive content for smaller screens -->
		<template #cell-[[primaryKey]]="{ row }">
			[[primaryCellContent]]
		</template>

		[[customCellRenderers]]

	</ListTable>
</template>

<script lang="ts">
export default {
	name: '[[ModuleName]]List',
}
</script>

<script setup lang="ts">
import { ref, computed } from "vue"
import { useI18n } from 'vue-i18n'
import * as icons from 'lucide-vue-next'
import type { FilterField, BulkAction } from "@/types"
import type { ReportColumn } from '@/components/report-table'
// Required by the FK cell renderers injected via [[customCellRenderers]]:
// every foreign-key column is wrapped in <RelatedRecordLink>. page.stub has
// carried this import all along; this stub did not, so the component compiled
// with an unresolved <RelatedRecordLink> and FK links would render as nothing.
import RelatedRecordLink from '@/components/RelatedRecordLink.vue'
import { Button } from "@/components/ui/button"
import { ListTable } from '@/components/list-table'
import { usePermissions } from '@/composables/usePermissions'
[[additionalImports]]

const { hasPermission } = usePermissions()
const { t } = useI18n()

defineProps({
	apiEndpoint: String,
})

const listRef = ref<InstanceType<typeof ListTable> | null>(null)

// Filter fields - will be populated when data is loaded
const filterFields = ref<FilterField[]>([])

// Define columns based on configuration
const columns = computed<ReportColumn[]>(() => [
	[[columns]]
])

const bulkActions = computed<BulkAction[]>(() => [[bulkActionsLiteral]])

const handleDataLoaded = (data: Record<string, any>) => {
	filterFields.value = data.filterFields || []
}
</script>
