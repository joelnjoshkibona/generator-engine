<template>
	<MainLayout :title="$t('[[moduleRoute]].details_title')"
		:back-link="'/[[moduleRoute]]/list'"
		:breadcrumbs="[{label: $t('common.dashboard'), href: '/dashboard'}, {label: $t('[[moduleRoute]].title'), href: '/[[moduleRoute]]/list'}, {label: $t('common.details'), href: null}]">
		<!-- Loading State -->
		<CardSkeleton v-if="isLoading" :cards="3" :hasHeader="false" />

		<!-- Main Content -->
		<div v-else class="space-y-4 p-2">
			<!-- Deleted record banner -->
			<div v-if="record?.deleted_at" class="flex items-center gap-3 rounded-lg border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive">
				<component :is="icons.Trash2Icon" class="h-4 w-4 shrink-0" />
				<span>This record was deleted on <strong>{{ formatDate(record.deleted_at) }}</strong>. It is read-only until restored.</span>
			</div>

			<!-- Header Row 1: Title left, status badge right -->
			<div class="flex items-start justify-between gap-4">
				<div>
					<CardTitle class="text-xl">{{ record?.[[primaryDisplayField]] || $t('[[moduleRoute]].details_title') }}</CardTitle>
					<p v-if="record?.[[secondaryDisplayField]]" class="text-sm text-muted-foreground">{{ record.[[secondaryDisplayField]] }}</p>
				</div>
				[[statusBadge]]
			</div>

			[[actionToolbar]]

			<!-- Metrics Row -->
			<div v-if="metrics && metrics.length > 0" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
				<Card v-for="metric in metrics" :key="metric.label" class="p-4">
					<div class="flex items-center gap-3">
						<div class="p-2 rounded-lg bg-primary/10">
							<component :is="icons[metric.icon as keyof typeof icons] || icons.InfoIcon" class="h-4 w-4" :class="metric.color || 'text-blue-400'" />
						</div>
						<div class="flex-1 min-w-0">
							<p class="text-xs text-muted-foreground font-medium">{{ metric.label }}</p>
							<p class="text-sm font-medium truncate">{{ metric.value }}</p>
						</div>
					</div>
				</Card>
			</div>

			<!-- [generator:region:shortcuts:start] -->
			<!-- [generator:region:shortcuts:end] -->
			<!-- Main Content Area -->
			<div class="space-y-4">
				<!-- Tabs Navigation -->
				<div class="tabs-header border-y bg-card">
					<div class="flex flex-wrap -mb-px">
						<router-link
							v-for="tab in navigationItems"
							:key="tab.id"
							:to="`/[[moduleRoute]]/${recordId}/details/${tab.id}`"
							custom
							v-slot="{ isActive, href, navigate }"
						>
							<a
								:href="href"
								@click="navigate"
								:data-testid="`[[moduleName]]-tab-${tab.id}`"
								class="inline-flex items-center h-10 px-4 py-2 text-sm font-medium mr-2"
								:class="[
								  isActive
									? 'text-primary border-b-2 border-primary'
									: 'text-foreground/60 hover:text-foreground hover:border-b-2 hover:border-border',
								]"
							>
								<component :is="tab.icon" v-if="tab.icon" class="mr-2 h-3 w-3" />
								{{ tab.label }}
							</a>
						</router-link>
					</div>
				</div>

				<!-- Router View for Tab Content -->
				<router-view @refresh="refresh" :data="record" :refresh-key="refreshKey"></router-view>
			</div>
		</div>
		[[crudModals]]
	</MainLayout>
</template>

<script setup lang="ts">
import { ref, computed, onMounted, watch } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { Button } from '@/components/ui/button'
import { Card, CardTitle } from '@/components/ui/card'
import CardSkeleton from '@/components/ui/loading/CardSkeleton.vue'
import * as icons from 'lucide-vue-next'
import { usePermissions } from '@/composables/usePermissions'
[[badgeImport]]
[[customFeatureImports]]
import MainLayout from '@/layouts/MainLayout.vue'
// [generator:region:shortcut-import:start]
// [generator:region:shortcut-import:end]
import { sendGetRequest, sendPostRequest } from "@/helpers"
import { AppDialog } from '@/components/app-dialog'
[[crudFormImports]]
import { DropdownMenu, DropdownMenuTrigger, DropdownMenuContent, DropdownMenuItem } from '@/components/ui/dropdown-menu'
import { toast } from "@/lib/toast"
import { useI18n } from 'vue-i18n'

const router = useRouter()
const route = useRoute()
const { hasPermission } = usePermissions()
const { t } = useI18n()

// State
const isLoading = ref(true)
const isRestoring = ref(false)
const record = ref<any>(null)
const editOpen = ref(false)
const deleteOpen = ref(false)
const refreshKey = ref(0)

const formatDate = (dateStr: string) => {
	if (!dateStr) return ''
	return new Date(dateStr).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
}

const restoreRecord = async () => {
	isRestoring.value = true
	try {
		const result = await sendPostRequest(`/trash/[[moduleRoute]]/${recordId.value}/restore`)
		if (result.status) {
			toast.success(t('[[moduleRoute]].restored_success'))
			await refresh()
		} else {
			toast.error(result.message || t('[[moduleRoute]].restored_error'))
		}
	} catch {
		toast.error(t('[[moduleRoute]].restored_error'))
	} finally {
		isRestoring.value = false
	}
}

// Define sidebar navigation items
const navigationItems = [
	[[tabs]]
]

// Get record UUID from route params
const recordId = computed(() => {
	return String(route.params.[[idParam]])
})

// Metrics Configuration
const metrics = computed(() => [
	[[metricsConfigs]]
])

// Navigation method for entity actions
function navigateTo(routeName: string, params?: Record<string, any>) {
	if (!recordId.value) return;

	router.push({
		name: routeName,
		params: {
			[[idParam]]: recordId.value,
			...params
		}
	});
}

const refresh = async () => {
	try {
		isLoading.value = true
		const result = await sendGetRequest(`/[[moduleRoute]]/${recordId.value}/view`)
		if (result.status) {
			record.value = result.data
		}
	} catch (error) {
		console.error('Failed to load [[ModuleName]] data:', error)
	} finally {
		isLoading.value = false
	}
}

function onUpdated() {
	editOpen.value = false
	refreshKey.value++
	refresh()
}

function onDeleted() {
	router.push('/[[moduleRoute]]/list')
}

// Fetch all required data
onMounted(async () => {
	await refresh()
})

// Watch for entity changes to update title
watch(() => record.value?.[[primaryDisplayField]], (newName) => {
	if (newName) {
		document.title = `${newName} | ${t('[[moduleRoute]].details_title')}`
	}
}, { immediate: true })

// Re-fetch data whenever the user navigates back to the overview tab.
watch(() => route.path.endsWith('/overview'), (isOverview) => {
	if (isOverview) refresh()
})
</script>

<style scoped>
</style>
