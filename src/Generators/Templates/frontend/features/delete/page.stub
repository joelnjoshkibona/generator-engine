<template>
	<MainLayout :title="$t('[[moduleRoute]].delete_btn')"
		:back-link="backLink"
		:breadcrumbs="[{label: $t('common.dashboard'), href: '/dashboard'}, {label: $t('[[moduleRoute]].title'), href: '/[[moduleRoute]]/list'}, {label: $t('common.delete'), href: null}]">
		<[[ModuleName]]DeleteForm :uuid="uuid" :cancel-link="backLink" />
	</MainLayout>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { useRoute } from 'vue-router'
import MainLayout from '@/layouts/MainLayout.vue'
import [[ModuleName]]DeleteForm from './Components/[[ModuleName]]DeleteForm.vue'

const route = useRoute()

const uuid = computed(() => route.params.uuid as string)
const backLink = computed(() => (route.query.back as string) || `/[[moduleRoute]]/${uuid.value}/details/overview`)
</script>
