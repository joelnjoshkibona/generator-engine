<template>
	<MainLayout title="Edit [[ModuleName]]" :breadcrumbs="[{label: 'Dashboard', href: '/dashboard'}, {label: '[[ModuleName]]', href: '/[[moduleRoute]]/list'}, {label: 'Edit', href: null}]">
		<[[ModuleName]]EditForm :id="id" :cancel-link="backLink" />
	</MainLayout>
</template>

<script setup lang="ts">
import { computed } from 'vue'
import { useRoute } from 'vue-router'
import MainLayout from '@/layouts/MainLayout.vue'
import [[ModuleName]]EditForm from './Components/[[ModuleName]]EditForm.vue'

const route = useRoute()
const id = route.params.uuid as string

// Get back link from query or default to details page
const backLink = computed(() => {
	return (route.query.back as string) || `/[[moduleRoute]]/${id}/details`
})
</script>
