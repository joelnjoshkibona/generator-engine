<script setup lang="ts">
import { ref } from 'vue'
import { useToast } from '@/components/ui/toast'
import { sendPostRequest } from '@/utils/api'

const { toast } = useToast()
const loading = ref(false)
const form = ref<Record<string, any>>({})

const handleSubmit = async () => {
    loading.value = true
    try {
        const result = await sendPostRequest(`/[[actionRoute]]/create`, form.value)
        if (result?.data?.success) {
            toast({ description: result.data.message ?? 'Action completed successfully' })
        }
    } catch (e) {
        toast({ description: 'An error occurred', variant: 'destructive' })
    } finally {
        loading.value = false
    }
}
</script>

<template>
    <div class="container mx-auto py-6">
        <div class="mb-6">
            <h1 class="text-2xl font-bold">[[ActionLabel]]</h1>
        </div>
        <div class="bg-card border rounded-lg p-6 space-y-4">
            <!-- Add your page content here -->
            <div class="flex justify-end">
                <button type="button" :disabled="loading" @click="handleSubmit"
                    class="inline-flex items-center px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium">
                    {{ loading ? 'Processing...' : 'Submit' }}
                </button>
            </div>
        </div>
    </div>
</template>
