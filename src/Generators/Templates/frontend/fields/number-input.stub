[[tabs]]<NumberInputField
[[tabs]]	v-if="[[fieldHiddenCondition]]"
[[tabs]]	id="[[fieldKey]]"
[[tabs]]	label="[[fieldLabel]]"
[[tabs]]	v-model="form.[[fieldKey]]"
[[tabs]]	:decimals="[[fieldDecimals]]"
[[tabs]]	placeholder="[[fieldPlaceholder]]"
[[tabs]]	[[fieldType]]
[[tabs]]	:required="[[fieldRequired]]"
[[tabs]]	:disabled="isSubmitting || [[fieldDisabled]] || isFieldDisabled('[[fieldKey]]')"
[[tabs]]	:error="errors.[[fieldKey]]"
[[tabs]]/>
