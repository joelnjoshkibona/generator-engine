[[tabs]]<template v-if="[[fieldHiddenCondition]]">
[[tabs]]	<div class="col-span-2">
[[tabs]]		<label class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">[[fieldLabel]]</label>
[[tabs]]		<[[inlineItemsWrapperComponent]]
[[tabs]]			v-model="form.[[fieldKey]]"
[[tabs]]			primary-field="[[primaryField]]"
[[tabs]]			add-button-text="[[addButtonText]]"
[[tabs]]			empty-message="[[emptyMessage]]"
[[tabs]]		/>
[[tabs]]	</div>
[[tabs]]</template>
