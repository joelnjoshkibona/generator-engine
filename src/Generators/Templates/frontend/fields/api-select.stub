[[tabs]]<template v-if="[[fieldHiddenCondition]]">
[[tabs]]	<ApiSelect2Field
[[tabs]]		id="[[fieldKey]]"
[[tabs]]		label="[[fieldLabel]]"
[[tabs]]		v-model="form.[[fieldKey]]"
[[tabs]]		:api-url="'[[fieldApiEndpoint]]'"
[[tabs]]		:option-label="'[[fieldOptionLabel]]'"
[[tabs]]		:option-value="'[[fieldOptionValue]]'"
[[tabs]]		:placeholder="'[[fieldPlaceholder]]'"
[[tabs]]		:error="errors.[[fieldKey]]"
[[tabs]]		:required="[[fieldRequired]]"
[[tabs]]		:disabled="isSubmitting || [[fieldDisabled]] || isFieldDisabled('[[fieldKey]]')"
[[tabs]]		:multiple="[[fieldMultiple]]"
[[tabs]]		:per-page="[[fieldPerPage]]"
[[tabs]]	/>
[[tabs]]</template>

