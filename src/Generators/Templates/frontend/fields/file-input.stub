[[tabs]]<template v-if="[[fieldHiddenCondition]]">
[[tabs]]	<div class="col-span-full">
[[tabs]]		<FileInputField
[[tabs]]			label="[[fieldLabel]]"
[[tabs]]			v-model="[[fieldModelRef]]"
[[tabs]]			:error="errors.[[fieldKey]]"
[[tabs]]			:required="[[fieldRequired]]"
[[tabs]]			:multiple="[[fieldMultiple]]"
[[tabs]]			accept="[[fieldAccept]]"
[[tabs]]			:max-size="[[fieldMaxSize]]"
[[tabs]]			:max-files="[[fieldMaxFiles]]"
[[tabs]]			:preview="[[fieldPreview]]"
[[tabs]]			:enable-crop="[[fieldEnableCrop]]"
[[tabs]]			:aspect-ratio="[[fieldAspectRatio]]"
[[tabs]]			crop-shape="[[fieldCropShape]]"
[[tabs]]			upload-mode="[[fieldUploadMode]]"
[[tabs]]			:disabled="isSubmitting || [[fieldDisabled]] || isFieldDisabled('[[fieldKey]]')"
[[tabs]]		/>
[[tabs]]	</div>
[[tabs]]</template>
