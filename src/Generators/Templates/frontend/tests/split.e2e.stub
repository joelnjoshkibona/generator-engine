'use strict';

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { test, expect } from '#e2e-helpers/fixtures.js';
import { loginWithRetry } from '#e2e-helpers/auth.js';
import { BASE_URL } from '#e2e-helpers/config.js';
import { createFixtureRecord, cleanupRecord } from './_fixtures.js';

/**
 * e2e/[[specFileName]]
 *
 * Auto-generated [[specKind]] smoke test for [[ModuleName]]'s "[[specLabel]]"
 * [[specKind]]. Generated by PlaywrightTestGenerator — split out of the CRUD
 * spec (see [[moduleRoute]]-crud.e2e.js) so a hand-edited [[specKind]] test
 * never gets clobbered by regenerating a DIFFERENT [[specKind]] (see
 * PlaywrightTestGenerator::regenerateOnly()).
 *
 * Creates its own fixture parent record via _fixtures.js rather than
 * depending on [[moduleRoute]]-crud.e2e.js having run first, and cleans it
 * up itself when done — safe to run independently, in any order, against the
 * shared dev DB.
 *
 * Run with: npx playwright test e2e/[[specFileName]]
 */

const MODULE_LABEL = '[[moduleRoute]]-[[specSlug]]';
const SCREENSHOT_DIR = path.join(path.dirname(fileURLToPath(import.meta.url)), 'screenshots');
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

function ensureScreenshotDir() {
	if (!fs.existsSync(SCREENSHOT_DIR)) fs.mkdirSync(SCREENSHOT_DIR, { recursive: true });
}

async function shot(page, name) {
	ensureScreenshotDir();
	const file = path.join(SCREENSHOT_DIR, `${MODULE_LABEL}-${name}.png`);
	await page.screenshot({ path: file, fullPage: true });
	console.log(`[${MODULE_LABEL}] screenshot: ${file}`);
}

/**
 * Wait until the ListTable's loading spinner is gone and at least the table
 * shell exists. See [[moduleRoute]]-crud.e2e.js for the full rationale.
 */
async function waitForListSettled(page, timeout = 15000) {
	await page.locator('table').waitFor({ timeout });
	await page.waitForFunction(() => !document.querySelector('svg.animate-spin'), { timeout }).catch(() => {});
	await sleep(1500);
}

/**
 * Click something and wait for a selector to appear, retrying the click a
 * few times if it doesn't. See [[moduleRoute]]-crud.e2e.js for the full
 * rationale.
 */
async function clickAndWaitForSelector(page, doClick, waitSelector, { attempts = 3, perAttemptTimeout = 6000 } = {}) {
	let lastErr;
	for (let i = 0; i < attempts; i++) {
		await doClick();
		try {
			await page.locator(waitSelector).first().waitFor({ timeout: perAttemptTimeout });
			return;
		} catch (err) {
			lastErr = err;
			console.log(`[${MODULE_LABEL}] click attempt ${i + 1}/${attempts} — "${waitSelector}" did not appear, retrying`);
			await sleep(500);
		}
	}
	throw lastErr;
}

