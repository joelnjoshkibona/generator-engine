'use strict';

import { test, expect } from '#e2e-helpers/fixtures.js';
import fs from 'node:fs';
import path from 'node:path';
import { shot as takeShot } from '#e2e-helpers/artifacts.js';
import { loginWithRetry } from '#e2e-helpers/auth.js';
import { BASE_URL } from '#e2e-helpers/config.js';
import { cleanupRecord } from './_fixtures.js';

/**
 * e2e/[[moduleRoute]]-create.e2e.js
 *
 * Auto-generated create-form smoke test for the [[ModuleName]] module:
 * empty-required-field validation, missing-required-file validation, fill +
 * submit, assert the new row appears. Generated by PlaywrightTestGenerator —
 * structurally mirrors the hand-written reference pattern in
 * location-types-crud.e2e.js (see that file, and
 * helpers/{fixtures,auth,config}.js, for the full rationale behind the
 * retry/settle helpers below).
 *
 * List/filter, view, edit, and delete coverage each live in their own
 * sibling file instead (e2e/[[moduleRoute]]-{list,view,edit,delete}.e2e.js),
 * plus one per delegation/action key — one hand-edited spec never risks
 * getting clobbered by regenerating a DIFFERENT surface (see
 * PlaywrightTestGenerator::regenerateOnly()), and no single file's scope
 * grows unboundedly as delegations/actions are added. This is the only one
 * of that set that creates its own record from scratch (that's what it's
 * testing) rather than via _fixtures.js's createFixtureRecord() — but it
 * still uses that same file's cleanupRecord() to remove what it created.
 *
 * Run with: npx playwright test e2e/[[moduleRoute]]-create.e2e.js
 */

const MODULE_LABEL = '[[moduleRoute]]-create';
// Screenshots go to one root for the whole run (FRONTEND/test-results/screenshots/{module}),
// not into this module's own source folder — see #e2e-helpers/artifacts.js. Override the
// root with E2E_ARTIFACTS_DIR so CI can collect from a path it uploads.
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

const shot = (page, name) => takeShot(page, MODULE_LABEL, name);

/**
 * Wait until the ListTable's loading spinner is gone and at least the table
 * shell exists. The extra settle delay gives reka-ui's Dialog/Presence
 * internals time to finish attaching listeners before the first click is
 * fired (see location-types-crud.e2e.js for the full rationale — clicking a
 * trigger button immediately after the spinner disappears has been observed
 * to silently no-op under headless Chrome).
 */
async function waitForListSettled(page, timeout = 15000) {
	await page.locator('table').waitFor({ timeout });
	await page.waitForFunction(() => !document.querySelector('svg.animate-spin'), { timeout }).catch(() => {});
	await sleep(1500);
}

/**
 * Click something and wait for a selector to appear, retrying the click a
 * few times if it doesn't — headless Chrome was observed to occasionally
 * "swallow" the very first click on a freshly-settled page (see
 * location-types-crud.e2e.js for the full rationale). Retrying the click
 * itself (not just re-waiting) is what reliably recovers from it.
 */
async function clickAndWaitForSelector(page, doClick, waitSelector, { attempts = 3, perAttemptTimeout = 6000 } = {}) {
	let lastErr;
	for (let i = 0; i < attempts; i++) {
		await doClick();
		try {
			await page.locator(waitSelector).first().waitFor({ timeout: perAttemptTimeout });
			return;
		} catch (err) {
			lastErr = err;
			console.log(`[${MODULE_LABEL}] click attempt ${i + 1}/${attempts} — "${waitSelector}" did not appear, retrying`);
			await sleep(500);
		}
	}
	throw lastErr;
}

[[helperFunctions]]

test.describe('[[moduleRoute]] / create', () => {
	test('[[testDescription]]', async ({ page, diagnostics }) => {
		const { pageErrors, failedRequests } = diagnostics;

		await loginWithRetry(page);

		const stamp = Date.now();

		// ── Navigate to list, per_page=100 + sort=id desc so a newly created
		// record is guaranteed visible on page 1 regardless of default sort. ──
		console.log(`[${MODULE_LABEL}] navigating to ${BASE_URL}/[[moduleRoute]]/list`);
		await page.goto(`${BASE_URL}/[[moduleRoute]]/list?per_page=100&sort=id&order=desc`, {
			waitUntil: 'networkidle',
			timeout: 30000,
		});
		await waitForListSettled(page);
		await shot(page, '01-list-page');

[[testBody]]

		// ── Diagnostics-based success criteria ───────────────────────────────
		expect(pageErrors, `zero pageerror events expected, got: ${JSON.stringify(pageErrors)}`).toHaveLength(0);
		expect(failedRequests, `zero requestfailed events expected, got: ${JSON.stringify(failedRequests)}`).toHaveLength(0);
	});
});
