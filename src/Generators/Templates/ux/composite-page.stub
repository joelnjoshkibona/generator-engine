<script setup lang="ts">
import { ref } from 'vue'
import { useRouter } from 'vue-router'
import MainLayout from '@/layouts/MainLayout.vue'
import { toast } from '@/lib/toast'
import { sendPostRequest } from '@/helpers'
[[sectionImports]]

const router = useRouter()
const loading = ref(false)
const activeSection = ref('[[firstSection]]')

// One data object per section — arrays for repeaters, objects for forms
[[sectionDataRefs]]

const sections = [[sectionsConfig]]

const handleSubmit = async () => {
    loading.value = true
    try {
        const result = await sendPostRequest('/[[apiEndpoint]]', {
[[sectionPayload]]
        })
        if (result?.data?.success) {
            toast.success(result.data.message ?? '[[Label]] created successfully')
            router.push({ name: '[[ModuleName]]' })
        }
    } catch {
        toast.error('An error occurred')
    } finally {
        loading.value = false
    }
}
</script>

<template>
    <MainLayout>
        <div class="max-w-4xl mx-auto space-y-6 p-6">
            <h1 class="text-2xl font-bold">[[Label]]</h1>

            <!-- Section tabs -->
            <div class="flex gap-2 border-b">
                <button
                    v-for="section in sections"
                    :key="section.name"
                    @click="activeSection = section.name"
                    :class="['px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors',
                        activeSection === section.name
                            ? 'border-primary text-primary'
                            : 'border-transparent text-muted-foreground hover:text-foreground']">
                    {{ section.label }}
                    <span v-if="section.optional" class="ml-1 text-xs text-muted-foreground">(optional)</span>
                </button>
            </div>

            <!-- Section panels -->
[[sectionPanels]]

            <!-- Submit -->
            <div class="flex justify-end gap-3 pt-4">
                <button type="button" @click="router.back()"
                    class="px-4 py-2 text-sm border rounded-md hover:bg-muted">
                    Cancel
                </button>
                <button type="button" :disabled="loading" @click="handleSubmit"
                    class="px-4 py-2 text-sm bg-primary text-primary-foreground rounded-md disabled:opacity-50">
                    {{ loading ? 'Creating...' : 'Create [[Label]]' }}
                </button>
            </div>
        </div>
    </MainLayout>
</template>
