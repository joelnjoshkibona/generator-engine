<?php

namespace [[namespace]]\Services;

use App\Project\_Src\Helpers;
use App\Project\_Src\ApplicationException;
use Illuminate\Support\Facades\DB;

class [[ModuleName]]CompositeCreateService
{
    public function execute(array $data, array $params = []): array
    {
        try {
            return DB::transaction(function () use ($data, $params) {
                return $this->process($data, $params);
            });
        } catch (ApplicationException $e) {
            return Helpers::error($e->getMessage(), 500, $e->getData());
        } catch (\Exception $e) {
            throw $e;
        }
    }

    protected function process(array $data, array $params = []): array
    {
        // 1. Create the parent record
        // $parent = [[ModuleName]]Model::create($data['[[parentSection]]'] ?? []);

