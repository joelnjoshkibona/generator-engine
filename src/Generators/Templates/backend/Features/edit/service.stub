<?php

namespace [[namespace]]\Services;

use App\Project\_Src\Helpers;
use App\Project\_Src\ApplicationException;
use [[namespace]]\[[ModuleName]]Model;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Auth;
use Illuminate\Database\Eloquent\Builder;

class [[ModuleName]]EditService
{

    /**
     * @param array $data Request data
     * @param array $params Route params (uuid)
     * @param Builder|null $query Base query, pre-scoped by a caller (e.g. a
     *        delegation service forcing a parent-record filter). A uuid that
     *        exists but doesn't match the scope naturally 404s here — no
     *        separate ownership check needed. Defaults to a fresh, unscoped
     *        query when omitted.
     */
    public static function execute(array $data, array $params, ?Builder $query = null)
    {
        DB::beginTransaction();
        try{
            $validParams = self::validateParams($params);
            $model = ($query ?? [[ModuleName]]Model::query())->where(['uuid' => $validParams['uuid']])->first();
            if(!$model) abort(404, 'Record not found');
            $inlineData = [];
            [[inlineItemsExtract]]
            $validData = self::validateData($data, $model);
            $result = self::process($validData, $validParams, $model, $inlineData);
            DB::commit();
            return $result;
        } catch(ApplicationException $e) {
            DB::rollBack();
            return Helpers::error($e->getMessage(), 422, $e->getData());
        } catch(\Illuminate\Database\UniqueConstraintViolationException $e) {
            DB::rollBack();
            return Helpers::error('This record conflicts with an existing one (duplicate value for a unique field or field combination).', 422);
        } catch(\Exception $e) {
            DB::rollBack();
            throw $e;
        }
    }

    protected static function validateData(array $data, $model): array
    {
        return validator(
            $data,
            [[validationRules]],
            [[validationMessages]]
        )->validate();
    }

    protected static function validateParams(array $params): array
    {
        return validator(
            $params,
            [
                'uuid' => ["required", "string", "exists:[[tableName]],uuid"],
            ], [
                'uuid.required' => 'The Uuid field is required.',
                'uuid.string' => 'The Uuid must be a string.',
                'uuid.exists' => 'The selected Uuid is invalid or does not exist in [[tableName]].',
            ]
        )->validate();
    }

    public static function process(array $validData, array $validParams, [[ModuleName]]Model $model, array $inlineData = []): array
    {
        if(!$model) throw new \Exception('[[ModuleName]] not found.');
        $data = self::beforeUpdate($validData, $validParams, $model);
        $model->update($data);
        [[inlineItemsSync]]
        $data = self::afterUpdate($data, $validParams, $model->fresh());
        return Helpers::success($data, "Record updated successfully");
    }

    public static function beforeUpdate($validData, array $validParams, [[ModuleName]]Model $model) {
        //Before Update
        $validData['updated_by_id'] = Auth::id();
        [[beforeUpdate]]
        return $validData;
    }

    public static function afterUpdate($data, array $validParams, [[ModuleName]]Model $model): [[ModuleName]]Model {
        //After Update
        [[afterUpdate]]
        return $model;
    }
}
