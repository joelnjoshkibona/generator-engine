    public function export[[DelegationName]](Request $request, string $[[parentKey]]): mixed
    {
        $data = $request->all();
        $data['params']['paginate'] = false;
        $data['export'] = true;
        $data['format'] = $request->get('format', 'csv');
        return [[ModuleName]][[DelegationName]]Service::list($[[parentKey]], $data);
    }
